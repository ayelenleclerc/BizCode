{
  "name": "@bizcode/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts"
  },
  "scripts": {
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts src"
  },
  "turbo": {
    "type-check": {
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*",
    "react-native-paper": "^5.15.3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-paper": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
