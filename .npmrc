# eslint-plugin-jsx-a11y peer range predates ESLint 10; relaxed peer resolution until the plugin declares ^10.
legacy-peer-deps=true
strict-peer-dependencies=false
# Flat node_modules for tooling that expects a classic layout (Vite, Prisma, lint-staged).
node-linker=hoisted
# Do NOT set package-import-method=copy: full copies make Windows installs very slow and still
# fail on the final rename under antivirus/IDE locks. Use pnpm's default (hardlink) instead.
# On Windows, see scripts/install-windows.ps1 and CONTRIBUTING.md (Windows install).
