  type      String    @db.VarChar(60)
  /// JSON payload: { clienteId?, facturaId?, amount?, limit?, rsocial? }
  payload   Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}

model ChatMessage {
