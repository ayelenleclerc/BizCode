  accessTokenEncrypted   String   @db.Text
  accessTokenLast4       String   @db.VarChar(4)
  publicKey              String   @db.VarChar(120)
  webhookSecretEncrypted String?  @db.Text
  sandboxMode            Boolean  @default(true)
  activo                 Boolean  @default(true)
  /// Mercado Pago instore POS (#177)
  collectorId            String?  @db.VarChar(30)
  externalPosId          String?  @db.VarChar(60)
  staticQrData           String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// @en Multi-provider payment configuration per tenant (#377, ADR-0019). Legacy `MercadoPagoConfig`
///   is kept for dual-read/write during the transition; `mercadopago` rows are backfilled from it.
/// @es Configuraci\u00f3n de proveedor de pagos multi-proveedor por tenant (#377, ADR-0019).
///   `MercadoPagoConfig` se conserva para lectura/escritura dual; las filas `mercadopago` se migran desde ah\u00ed.
/// @pt-BR Configura\u00e7\u00e3o de provedor de pagamentos multi-provedor por tenant (#377, ADR-0019).
///   `MercadoPagoConfig` \u00e9 mantido para leitura/escrita dupla; as linhas `mercadopago` s\u00e3o migradas dele.
model PaymentProviderConfig {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  /// mercadopago | payway | stripe (PaymentProviderCode)
  providerCode     String    @db.VarChar(30)
  /// sandbox | production
  environment      String    @default("sandbox") @db.VarChar(20)
  enabled          Boolean   @default(true)
  isDefault        Boolean   @default(false)
  /// @en AES-256-GCM ciphertext of provider-specific JSON secrets (encryptFiscalSecret).
  encryptedConfig  String    @db.Text
  accessTokenLast4 String?   @db.VarChar(4)
  publicKey        String?   @db.VarChar(120)
  webhookSecretSet Boolean   @default(false)
  configVersion    Int       @default(1)
  lastValidationAt DateTime?
  validationStatus String?   @db.VarChar(20)
  validationError  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, providerCode])
  @@index([tenantId])
  @@index([providerCode])
}

/// @en Generic payment operation ledger multi-provider (#377 DoD). Dual-writes Factura.mp* until a future cutover ADR.
/// @es Libro de operaciones de cobro multi-proveedor (#377 DoD). Dual-write con Factura.mp* hasta ADR de corte.
/// @pt-BR Livro de opera\u00e7\u00f5es de cobran\u00e7a multi-provedor (#377 DoD). Dual-write com Factura.mp* at\u00e9 ADR de corte.
model PaymentTransaction {
  id                Int          @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  /// mercadopago | payway | stripe (PaymentProviderCode)
  providerCode      String       @db.VarChar(30)
  externalPaymentId String?      @db.VarChar(80)
  externalReference String?      @db.VarChar(120)
  /// e.g. factura:{id}
  internalReference String       @db.VarChar(120)
  /// preference | qr | refund | webhook | checkout
  paymentType       String       @db.VarChar(30)
  /// Normalized PaymentStatus (#377)
  status            String       @db.VarChar(30)
  providerStatus    String?      @db.VarChar(40)
  amount            Decimal      @db.Decimal(14, 2)
  currency          String       @default("ARS") @db.VarChar(3)
  checkoutUrl       String?      @db.VarChar(500)
  preferenceId      String?      @db.VarChar(80)
  idempotencyKey    String       @db.VarChar(120)
  facturaId         Int?
  factura           Factura?     @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  reciboCobroId     Int?
  reciboCobro       ReciboCobro? @relation(fields: [reciboCobroId], references: [id], onDelete: SetNull)
  rawMetadata       Json?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  expiredAt         DateTime?
  refundedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, providerCode])
  @@index([tenantId, facturaId])
  @@index([externalPaymentId])
  @@index([internalReference])
}

/// MercadoLibre OAuth tokens per tenant (#183); access/refresh encrypted at rest.
model MeliConfig {
