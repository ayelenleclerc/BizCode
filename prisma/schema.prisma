/// Supplier payable alert settings per tenant (#275).
model AlertaProveedorConfig {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  diasPrevioAviso Int      @default(3)
  diasCritico     Int      @default(7)
  notifEmail      Boolean  @default(true)
  notifInApp      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Dedup log for supplier payable alerts (#275).
model AlertaProveedorLog {
  id                  Int               @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  comprobanteCompraId Int
  comprobanteCompra   ComprobanteCompra @relation(fields: [comprobanteCompraId], references: [id])
  /// proxima_vencer | vencida_hoy | vencida_critica | limite_credito
  tipo                String            @db.VarChar(30)
  enviadoAt           DateTime          @default(now())

  @@index([tenantId, comprobanteCompraId, tipo, enviadoAt])
}

/// Supplier payment receipt (#271).
model ReciboPago {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  numero      Int
  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  fecha       DateTime
  total       Decimal   @db.Decimal(14, 2)
  /// transferencia | cheque | efectivo | echeq
  metodoPago  String    @db.VarChar(20)
  chequeId    Int?
  cheque      Cheque?   @relation(fields: [chequeId], references: [id])
  cbu         String?   @db.VarChar(22)
  referencia  String?   @db.VarChar(60)
  /// emitido | anulado
  estado      String    @default("emitido") @db.VarChar(20)
  notas       String?   @db.VarChar(500)
  usuarioId   Int
  usuario     AppUser   @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  facturas             ReciboPagoFactura[]
  movimiento           MovimientoProveedorCC?
  retencionesAplicadas RetencionAplicada[]

  @@unique([tenantId, numero])
  @@index([tenantId, proveedorId])
  @@index([tenantId, proveedorId, fecha])
}

model ReciboPagoFactura {
  id                  Int                @id @default(autoincrement())
  reciboPagoId        Int
  reciboPago          ReciboPago         @relation(fields: [reciboPagoId], references: [id], onDelete: Cascade)
  comprobanteCompraId Int?
  comprobanteCompra   ComprobanteCompra? @relation(fields: [comprobanteCompraId], references: [id])
  facturaRef          String             @db.VarChar(40)
  monto               Decimal            @db.Decimal(14, 2)

  @@index([reciboPagoId])
}

/// Supplier accounts-payable ledger (#270).
model MovimientoProveedorCC {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  proveedorId         Int
  proveedor           Proveedor          @relation(fields: [proveedorId], references: [id])
  /// factura_compra | pago | nc_proveedor | ajuste
  tipo                String             @db.VarChar(20)
  referencia          String?            @db.VarChar(40)
  /// Positive increases debt; negative reduces debt.
  monto               Decimal            @db.Decimal(14, 2)
  saldoPost           Decimal            @db.Decimal(14, 2)
  fecha               DateTime
  usuarioId           Int
  usuario             AppUser            @relation(fields: [usuarioId], references: [id])
  notas               String?            @db.VarChar(500)
  comprobanteCompraId Int?               @unique
  comprobanteCompra   ComprobanteCompra? @relation(fields: [comprobanteCompraId], references: [id])
  reciboPagoId        Int?               @unique
  reciboPago          ReciboPago?        @relation(fields: [reciboPagoId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([tenantId, proveedorId, fecha])
  @@index([tenantId, proveedorId])
}

/// Customer accounts-receivable ledger (#232).
model MovimientoClienteCC {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  clienteId           Int
  cliente             Cliente            @relation(fields: [clienteId], references: [id])
  /// saldo_inicial | factura | nota_credito | cobro | retencion | percepcion | cheque_rechazado | ajuste
  tipo                String             @db.VarChar(20)
  referencia          String?            @db.VarChar(40)
  /// Positive increases customer debt; negative reduces debt.
  monto               Decimal            @db.Decimal(14, 2)
  /// @en Export vertical (#206): ISO-4217 currency of this entry; running balance is kept per currency.
  /// @es Vertical exportación (#206): moneda ISO-4217 del asiento; el saldo corrido se lleva por moneda.
  /// @pt-BR Vertical exportação (#206): moeda ISO-4217 do lançamento; o saldo corrente é mantido por moeda.
  moneda              String             @default("ARS") @db.VarChar(3)
  saldoPost           Decimal            @db.Decimal(14, 2)
  fecha               DateTime
  usuarioId           Int
  usuario             AppUser            @relation(fields: [usuarioId], references: [id])
  notas               String?            @db.VarChar(500)
  facturaId           Int?               @unique
  factura             Factura?           @relation(fields: [facturaId], references: [id])
  cobroId             Int?               @unique
  cobro               Cobro?             @relation(fields: [cobroId], references: [id])
  notaCreditoId       Int?               @unique
  notaCredito         NotaCredito?       @relation(fields: [notaCreditoId], references: [id])
  chequeId            Int?               @unique
  cheque              Cheque?            @relation(fields: [chequeId], references: [id])
  retencionAplicadaId Int?               @unique
  retencionAplicada   RetencionAplicada? @relation(fields: [retencionAplicadaId], references: [id])
  reciboCobroId       Int?               @unique
  reciboCobro         ReciboCobro?       @relation(fields: [reciboCobroId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([tenantId, clienteId, fecha])
  @@index([tenantId, clienteId])
  @@index([tenantId, clienteId, moneda, fecha])
}

/// Customer payment receipt (#233).
model ReciboCobro {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  numero          Int
  clienteId       Int
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  fecha           DateTime
  totalCobrado    Decimal  @db.Decimal(14, 2)
  concepto        String?  @db.VarChar(500)
  /// emitido | anulado
  estado          String   @default("emitido") @db.VarChar(20)
  anulacionMotivo String?  @db.VarChar(500)
  usuarioId       Int
  usuario         AppUser  @relation(fields: [usuarioId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  formas                           ReciboCobroForma[]
  imputaciones                     ReciboCobroImputacion[]
  movimientoCC                     MovimientoClienteCC?
  retencionesAplicadas             RetencionAplicada[]
  mercadoPagoProcessedPayments     MercadoPagoProcessedPayment[]
  mercadoPagoReconciliationEntries MercadoPagoReconciliationEntry[]
  mercadoPagoRefunds               MercadoPagoRefund[]
  paymentTransactions              PaymentTransaction[]
  liquidacionComisionDetalles      LiquidacionComisionDetalle[]

  @@unique([tenantId, numero])
  @@index([tenantId, clienteId])
  @@index([tenantId, clienteId, fecha])
}

model ReciboCobroForma {
  id            Int         @id @default(autoincrement())
  reciboCobroId Int
  reciboCobro   ReciboCobro @relation(fields: [reciboCobroId], references: [id], onDelete: Cascade)
  /// efectivo | transferencia | cheque | mercadopago | tarjeta | otro
  tipo          String      @db.VarChar(20)
  importe       Decimal     @db.Decimal(14, 2)
  chequeId      Int?
  cheque        Cheque?     @relation(fields: [chequeId], references: [id])
  referencia    String?     @db.VarChar(60)
  banco         String?     @db.VarChar(50)

  @@index([reciboCobroId])
}

model ReciboCobroImputacion {
  id                          Int                          @id @default(autoincrement())
  reciboCobroId               Int
  reciboCobro                 ReciboCobro                  @relation(fields: [reciboCobroId], references: [id], onDelete: Cascade)
  facturaId                   Int
  factura                     Factura                      @relation(fields: [facturaId], references: [id])
  importe                     Decimal                      @db.Decimal(14, 2)
  saldoPrevio                 Decimal                      @db.Decimal(14, 2)
  saldoPostPago               Decimal                      @db.Decimal(14, 2)
  liquidacionComisionDetalles LiquidacionComisionDetalle[]

  @@index([reciboCobroId])
  @@index([facturaId])
}

/// @en Seller commission rate configuration with optional client/category overrides (#237).
/// @es Configuración de alícuota de comisión de vendedor con overrides opcionales por cliente/categoría (#237).
/// @pt-BR Configuração de alíquota de comissão de vendedor com overrides opcionais por cliente/categoria (#237).
model ConfigComision {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  vendedorId          Int
  vendedor            AppUser            @relation("ConfigComisionVendedor", fields: [vendedorId], references: [id])
  /// porcentaje_cobrado | porcentaje_facturado | importe_fijo_por_venta
  tipo                String             @db.VarChar(40)
  alicuota            Decimal            @db.Decimal(14, 4)
  vigenciaDesde       DateTime
  vigenciaHasta       DateTime?
  articuloCategoriaId Int?
  articuloCategoria   CategoriaArticulo? @relation(fields: [articuloCategoriaId], references: [id], onDelete: SetNull)
  clienteId           Int?
  cliente             Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId, vendedorId])
  @@index([tenantId, vendedorId, vigenciaDesde])
  @@index([tenantId, clienteId])
  @@index([tenantId, articuloCategoriaId])
}

/// @en Monthly commission settlement for one seller (#237).
/// @es Liquidación mensual de comisión de un vendedor (#237).
/// @pt-BR Liquidação mensal de comissão de um vendedor (#237).
model LiquidacionComision {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  vendedorId    Int
  vendedor      AppUser   @relation("LiquidacionComisionVendedor", fields: [vendedorId], references: [id])
  /// YYYY-MM
  periodo       String    @db.VarChar(7)
  totalVentas   Decimal   @default(0) @db.Decimal(14, 2)
  totalComision Decimal   @default(0) @db.Decimal(14, 2)
  /// borrador | aprobada | pagada
  estado        String    @default("borrador") @db.VarChar(20)
  aprobadoPorId Int?
  aprobadoPor   AppUser?  @relation("LiquidacionComisionAprobadoPor", fields: [aprobadoPorId], references: [id])
  pagadoEn      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  detalle LiquidacionComisionDetalle[]

  @@unique([tenantId, vendedorId, periodo])
  @@index([tenantId, periodo])
  @@index([tenantId, estado])
}

/// @en Line of a commission settlement (#237).
/// @es Línea de una liquidación de comisión (#237).
/// @pt-BR Linha de uma liquidação de comissão (#237).
model LiquidacionComisionDetalle {
  id            Int                    @id @default(autoincrement())
  liquidacionId Int
  liquidacion   LiquidacionComision    @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  facturaId     Int?
  factura       Factura?               @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  reciboCobroId Int?
  reciboCobro   ReciboCobro?           @relation(fields: [reciboCobroId], references: [id], onDelete: SetNull)
  imputacionId  Int?
  imputacion    ReciboCobroImputacion? @relation(fields: [imputacionId], references: [id], onDelete: SetNull)
  montoBase     Decimal                @db.Decimal(14, 2)
  alicuota      Decimal                @db.Decimal(14, 4)
  comision      Decimal                @db.Decimal(14, 2)
  concepto      String                 @db.VarChar(200)

  @@index([liquidacionId])
  @@index([facturaId])
  @@index([reciboCobroId])
  @@index([imputacionId])
}

/// @en Async bulk import job for Excel/CSV (#238).
/// @es Trabajo de importación masiva Excel/CSV (#238).
/// @pt-BR Trabalho de importação em massa Excel/CSV (#238).
model ImportJob {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  /// articulos | clientes | proveedores | saldos
  entity         String    @db.VarChar(20)
  /// validating | ready | running | completed | failed | cancelled
  estado         String    @default("ready") @db.VarChar(20)
  /// mejores_esfuerzos | todo_o_nada
  modo           String    @default("mejores_esfuerzos") @db.VarChar(20)
  /// update | skip
  duplicateMode  String    @default("skip") @db.VarChar(20)
  totalRows      Int       @default(0)
  processedRows  Int       @default(0)
  okCount        Int       @default(0)
  errorCount     Int       @default(0)
  duplicateCount Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  skippedCount   Int       @default(0)
  /// Serialized row issues + final report metadata (JSON).
  reportJson     Json?
  createdById    Int
  createdBy      AppUser   @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, estado])
}

/// @en Exchange rate history per tenant for USD/EUR catalog pricing (#243).
/// @es Historial de tipos de cambio por tenant para precios USD/EUR (#243).
/// @pt-BR Histórico de câmbio por tenant para preços USD/EUR (#243).
model TipoCambio {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  /// USD | EUR
  moneda      String   @db.VarChar(3)
  /// oficial | mep | ccl | blue | manual
  tipo        String   @db.VarChar(20)
  valor       Decimal  @db.Decimal(14, 4)
  fecha       DateTime @default(now())
  /// bcra_api | manual
  fuente      String   @db.VarChar(20)
  createdById Int?
  createdBy   AppUser? @relation("TipoCambioCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  facturas Factura[]

  @@index([tenantId, moneda, tipo, fecha])
  @@index([tenantId, fecha])
}

/// @en Production BOM formula for a finished article (#248).
/// @es Fórmula BOM de producción para un artículo terminado (#248).
/// @pt-BR Fórmula BOM de produção para um artigo acabado (#248).
model FormulaProduccion {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  articuloId        Int
  articulo          Articulo @relation("FormulaProducto", fields: [articuloId], references: [id], onDelete: Restrict)
  /// @en Units produced by one formula run.
  /// @es Unidades producidas por una corrida de la fórmula.
  /// @pt-BR Unidades produzidas por uma corrida da fórmula.
  rendimiento       Decimal  @default(1) @db.Decimal(14, 4)
  unidadRendimiento String   @default("unidad") @db.VarChar(12)
  version           Int      @default(1)
  activa            Boolean  @default(true)
  observaciones     String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  insumos           FormulaInsumo[]
  ordenesProduccion OrdenProduccion[]

  @@index([tenantId])
  @@index([tenantId, articuloId])
  @@index([tenantId, articuloId, activa])
  @@index([tenantId, activa])
}

/// @en Input line of a production BOM formula (#248).
/// @es Línea de insumo de una fórmula BOM (#248).
/// @pt-BR Linha de insumo de uma fórmula BOM (#248).
model FormulaInsumo {
  id         Int               @id @default(autoincrement())
  formulaId  Int
  formula    FormulaProduccion @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  articuloId Int
  articulo   Articulo          @relation("FormulaInsumoArticulo", fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad   Decimal           @db.Decimal(14, 4)
  /// kg | g | l | ml | unidad | hora
  unidad     String            @db.VarChar(12)
  esOpcional Boolean           @default(false)
  orden      Int               @default(0)

  @@index([formulaId])
  @@index([articuloId])
}

/// @en Production order that consumes BOM inputs and credits finished goods (#249).
/// @es Orden de producción que consume insumos BOM y acredita producto terminado (#249).
/// @pt-BR Ordem de produção que consome insumos BOM e credita produto acabado (#249).
model OrdenProduccion {
  id             Int               @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  /// @en Sequential order number per tenant, rendered as OP-00001.
  /// @es Número secuencial por tenant, mostrado como OP-00001.
  /// @pt-BR Número sequencial por tenant, exibido como OP-00001.
  numero         Int
  articuloId     Int
  articulo       Articulo          @relation("OrdenProduccionProducto", fields: [articuloId], references: [id], onDelete: Restrict)
  /// @en Formula version used when the order was planned.
  /// @es Versión de fórmula usada al planificar la orden.
  /// @pt-BR Versão da fórmula usada ao planejar a ordem.
  formulaId      Int
  formula        FormulaProduccion @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  depositoId     Int
  deposito       Deposito          @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  cantidadPlanif Decimal           @db.Decimal(14, 4)
  cantidadReal   Decimal?          @db.Decimal(14, 4)
  /// planificada | en_proceso | completada | cancelada
  estado         String            @default("planificada") @db.VarChar(20)
  fechaPlanif    DateTime          @default(now())
  fechaInicio    DateTime?
  fechaFin       DateTime?
  /// @en Real production cost computed when the order is completed.
  /// @es Costo real de producción calculado al completar la orden.
  /// @pt-BR Custo real de produção calculado ao concluir a ordem.
  costoTotal     Decimal?          @db.Decimal(14, 2)
  operadorId     Int?
  operador       AppUser?          @relation("OrdenProduccionOperador", fields: [operadorId], references: [id], onDelete: SetNull)
  observaciones  String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  insumos  OrdenProduccionInsumo[]
  reservas StockReservaProduccion[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, articuloId])
  @@index([tenantId, depositoId, estado])
  @@index([tenantId, fechaPlanif])
}

/// @en Planned/real input line of a production order, frozen from the BOM (#249).
/// @es Línea de insumo planificada/real de una orden de producción, congelada del BOM (#249).
/// @pt-BR Linha de insumo planejada/real de uma ordem de produção, congelada do BOM (#249).
model OrdenProduccionInsumo {
  id           Int             @id @default(autoincrement())
  ordenId      Int
  orden        OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  articuloId   Int
  articulo     Articulo        @relation("OrdenProduccionInsumoArticulo", fields: [articuloId], references: [id], onDelete: Restrict)
  cantidadPlan Decimal         @db.Decimal(14, 4)
  cantidadReal Decimal?        @db.Decimal(14, 4)
  /// kg | g | l | ml | unidad | hora
  unidad       String          @db.VarChar(12)
  /// @en Unit cost snapshot taken when the order is completed.
  /// @es Snapshot de costo unitario tomado al completar la orden.
  /// @pt-BR Snapshot de custo unitário obtido ao concluir a ordem.
  costo        Decimal?        @db.Decimal(14, 2)
  esOpcional   Boolean         @default(false)
  linea        Int             @default(0)

  @@index([ordenId])
  @@index([articuloId])
}

/// @en Soft stock reservation held by an in-progress production order (#249).
/// @es Reserva blanda de stock que mantiene una orden de producción en proceso (#249).
/// @pt-BR Reserva flexível de estoque mantida por uma ordem de produção em processo (#249).
model StockReservaProduccion {
  id         Int             @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  ordenId    Int
  orden      OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  articuloId Int
  articulo   Articulo        @relation("StockReservaProduccionArticulo", fields: [articuloId], references: [id], onDelete: Restrict)
  depositoId Int
  deposito   Deposito        @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  cantidad   Decimal         @db.Decimal(14, 4)
  activa     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  releasedAt DateTime?

  @@index([ordenId])
  @@index([tenantId, articuloId, depositoId, activa])
  @@index([tenantId, activa])
}

/// @en Loyalty program configuration per tenant (#250).
/// @es Configuración del programa de fidelización por tenant (#250).
/// @pt-BR Configuração do programa de fidelização por tenant (#250).
model ConfigFidelizacion {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  activo            Boolean  @default(false)
  nombre            String   @default("Programa de Puntos") @db.VarChar(80)
  /// @en Currency amount that earns 1 point.
  /// @es Monto en pesos que otorga 1 punto.
  /// @pt-BR Valor em pesos que concede 1 ponto.
  pesosPorPunto     Decimal  @default(100) @db.Decimal(14, 4)
  /// @en Discount money per redeemed point.
  /// @es Dinero de descuento por punto canjeado.
  /// @pt-BR Dinheiro de desconto por ponto resgatado.
  puntosPorPeso     Decimal  @default(0.01) @db.Decimal(14, 6)
  /// @en Months until unused accumulation expires; null = never.
  /// @es Meses hasta que vence la acumulación sin usar; null = no vence.
  /// @pt-BR Meses até o vencimento da acumulação sem uso; null = não vence.
  mesesVencimiento  Int?
  montoMinCompra    Decimal  @default(0) @db.Decimal(14, 2)
  /// @en When false, line discounts (dscto) are excluded from the accrual base.
  /// @es Si es false, los descuentos de línea (dscto) se excluyen de la base de acumulación.
  /// @pt-BR Se for false, os descontos de linha (dscto) são excluídos da base de acumulação.
  aplicaEnDescuento Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// @en FEFO / lot expiry alert configuration per tenant (#202).
/// @es Configuración de alerta de vencimiento FEFO/lotes por tenant (#202).
/// @pt-BR Configuração de alerta de vencimento FEFO/lotes por tenant (#202).
model ConfigFefo {
  id                    Int      @id @default(autoincrement())
  tenantId              Int      @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  diasAlertaVencimiento Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// @en Inventory lot with expiry for FEFO allocation (#202).
/// @es Lote de inventario con vencimiento para asignación FEFO (#202).
/// @pt-BR Lote de inventário com vencimento para alocação FEFO (#202).
model Lote {
  id                Int        @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  articuloId        Int
  articulo          Articulo   @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  depositoId        Int
  deposito          Deposito   @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  proveedorId       Int?
  proveedor         Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  nroLote           String     @db.VarChar(60)
  /// @en Pharmacy vertical: unit serial captured locally at receipt/dispensing (#204); no ANMAT SNT round-trip.
  /// @es Vertical farmacia: serial unitario capturado localmente al ingreso/dispensación (#204); sin envío al SNT de ANMAT.
  /// @pt-BR Vertical farmácia: serial unitário capturado localmente na entrada/dispensação (#204); sem envio ao SNT da ANMAT.
  serialUnidad      String?    @db.VarChar(60)
  /// @en Pharmacy vertical: raw GS1/DataMatrix payload typed or pasted by the operator (#204); not parsed.
  /// @es Vertical farmacia: contenido GS1/DataMatrix tipeado o pegado por el operador (#204); no se parsea.
  /// @pt-BR Vertical farmácia: conteúdo GS1/DataMatrix digitado ou colado pelo operador (#204); não é parseado.
  codigoDatamatrix  String?    @db.VarChar(200)
  fechaVencimiento  DateTime   @db.Date
  fechaIngreso      DateTime   @default(now())
  stockInicial      Decimal    @db.Decimal(14, 4)
  stockActual       Decimal    @db.Decimal(14, 4)
  activo            Boolean    @default(true)
  preavisoEnviadoAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  facturaItems FacturaItem[]
  pedidoItems  PedidoItem[]
  stockAjustes StockAjuste[]

  librosPsicotropicos LibroPsicotropicoMovimiento[]

  @@unique([tenantId, articuloId, depositoId, nroLote])
  @@index([tenantId])
  @@index([tenantId, articuloId, depositoId, fechaVencimiento])
  @@index([tenantId, fechaVencimiento])
  @@index([tenantId, activo, stockActual])
}

/// @en Prescription recorded when dispensing controlled articles (#204); local record, no ANMAT SNT submission.
/// @es Receta registrada al dispensar artículos controlados (#204); registro local, sin envío al SNT de ANMAT.
/// @pt-BR Receita registrada ao dispensar artigos controlados (#204); registro local, sem envio ao SNT da ANMAT.
model RecetaDispensacion {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  facturaId     Int?
  factura       Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  clienteId     Int?
  cliente       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  numeroReceta  String   @db.VarChar(40)
  medicoNombre  String   @db.VarChar(120)
  matricula     String   @db.VarChar(40)
  fechaReceta   DateTime @db.Date
  observaciones String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movimientos LibroPsicotropicoMovimiento[]

  @@unique([tenantId, numeroReceta])
  @@index([tenantId])
  @@index([tenantId, facturaId])
  @@index([tenantId, clienteId])
  @@index([tenantId, fechaReceta])
}

/// @en Internal psychotropic movement book entry (#204); CSV-exportable, not the official SEDRONAR filing format.
/// @es Asiento del libro interno de psicotrópicos (#204); exportable a CSV, no es el formato oficial de SEDRONAR.
/// @pt-BR Lançamento do livro interno de psicotrópicos (#204); exportável em CSV, não é o formato oficial do SEDRONAR.
model LibroPsicotropicoMovimiento {
  id            Int                 @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  articuloId    Int
  articulo      Articulo            @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  loteId        Int?
  lote          Lote?               @relation(fields: [loteId], references: [id], onDelete: SetNull)
  recetaId      Int?
  receta        RecetaDispensacion? @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  /// ingreso | egreso | ajuste
  tipo          String              @db.VarChar(10)
  cantidad      Decimal             @db.Decimal(14, 4)
  /// @en Free-form origin reference such as `factura:123` or `ajuste:45`.
  /// @es Referencia libre de origen, p. ej. `factura:123` o `ajuste:45`.
  /// @pt-BR Referência livre de origem, p. ex. `factura:123` ou `ajuste:45`.
  referencia    String?             @db.VarChar(60)
  observaciones String?             @db.VarChar(300)
  createdAt     DateTime            @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, articuloId, createdAt])
  @@index([tenantId, tipo])
}

/// @en Current loyalty points balance per customer (#250).
/// @es Saldo actual de puntos de fidelización por cliente (#250).
/// @pt-BR Saldo atual de pontos de fidelização por cliente (#250).
model PuntosFidelizacion {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clienteId Int      @unique
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  puntos    Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, clienteId])
  @@index([tenantId])
  @@index([tenantId, puntos])
}

/// @en Loyalty points ledger movement (#250).
/// @es Movimiento del ledger de puntos de fidelización (#250).
/// @pt-BR Movimento do ledger de pontos de fidelização (#250).
model MovimientoPuntos {
  id                  Int       @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  clienteId           Int
  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// acumulacion | canje | ajuste | vencimiento | reverso
  tipo                String    @db.VarChar(20)
  /// @en Signed delta: positive accrues, negative redeems/expires.
  /// @es Delta con signo: positivo acumula, negativo canjea/vence.
  /// @pt-BR Delta com sinal: positivo acumula, negativo resgata/vence.
  puntos              Int
  saldoPost           Int
  /// @en Remaining points of an accumulation lot (FIFO expiry/redemption).
  /// @es Puntos restantes de un lote de acumulación (FIFO vencimiento/canje).
  /// @pt-BR Pontos restantes de um lote de acumulação (FIFO vencimento/resgate).
  puntosRestantes     Int?
  referenciaFacturaId Int?
  referenciaFactura   Factura?  @relation(fields: [referenciaFacturaId], references: [id], onDelete: SetNull)
  venceEn             DateTime?
  preavisoEnviadoAt   DateTime?
  concepto            String?   @db.VarChar(200)
  userId              Int?
  user                AppUser?  @relation("MovimientoPuntosUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  @@index([tenantId, clienteId, createdAt])
  @@index([tenantId, tipo, createdAt])
  @@index([tenantId, referenciaFacturaId])
  @@index([tenantId, venceEn, tipo])
}

model StockAjuste {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  articuloId Int
  articulo   Articulo  @relation(fields: [articuloId], references: [id])
  cantidad   Decimal   @db.Decimal(14, 4)
  motivo     String    @db.VarChar(100)
  userId     Int
  user       AppUser   @relation(fields: [userId], references: [id])
  /// @en Deposit affected by the adjustment when inventory.warehouses is enabled (#236).
  /// @es Depósito afectado por el ajuste cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito afetado pelo ajuste quando inventory.warehouses está ativo (#236).
  depositoId Int?
  deposito   Deposito? @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  /// @en Lot affected by the adjustment when the article tracks lots (#202).
  /// @es Lote afectado por el ajuste cuando el artículo controla lotes (#202).
  /// @pt-BR Lote afetado pelo ajuste quando o artigo controla lotes (#202).
  loteId     Int?
  lote       Lote?     @relation(fields: [loteId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([tenantId, articuloId])
  @@index([tenantId, articuloId, createdAt])
  @@index([tenantId, depositoId])
  @@index([loteId])
}

model AppSession {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @db.VarChar(64)
  /// Opaque session family id for refresh reuse detection (#212).
  tokenFamily String    @db.VarChar(36)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  userAgent   String?   @db.VarChar(255)
  ipAddress   String?   @db.VarChar(64)

  @@index([userId, tokenFamily])
  @@index([tokenFamily])
}

/// Rotating opaque refresh tokens with family reuse detection (#212).
model AppRefreshToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily String    @db.VarChar(36)
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  userAgent   String?   @db.VarChar(255)
  ipAddress   String?   @db.VarChar(64)

  @@index([userId, tokenFamily])
  @@index([tokenFamily])
  @@index([expiresAt])
}

/// Single-use MFA backup codes (#213); plaintext shown once at enroll; stored as scrypt via hashPassword.
model AppMfaBackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditEvent {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  userId            Int?
  user              AppUser? @relation(fields: [userId], references: [id])
  action            String   @db.VarChar(80)
  resource          String   @db.VarChar(80)
  resourceId        String?  @db.VarChar(120)
  ipAddress         String?  @db.VarChar(64)
  metadata          Json?
  /// @en Security taxonomy label for monitoring rules (#221).
  /// @es Etiqueta de taxonomía de seguridad para reglas de monitoreo (#221).
  /// @pt-BR Rótulo de taxonomia de segurança para regras de monitoramento (#221).
  securityEventType String?  @db.VarChar(60)
  /// @en Alert severity: critical | high | info (#221).
  /// @es Severidad de alerta: critical | high | info (#221).
  /// @pt-BR Severidade do alerta: critical | high | info (#221).
  severity          String?  @db.VarChar(20)
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([securityEventType, createdAt])
  @@index([severity, createdAt])
}

/// @en Watermark for the security monitor poller (#221).
/// @es Marca de agua del poller de monitoreo de seguridad (#221).
/// @pt-BR Marca d'água do poller de monitoramento de segurança (#221).
model SecurityMonitorCursor {
  id               String   @id @db.VarChar(40)
  lastAuditEventId Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/// @en Dedupes security alert firings by rule + subject (#221).
/// @es Evita alertas duplicadas por regla + sujeto (#221).
/// @pt-BR Evita alertas duplicadas por regra + sujeito (#221).
model SecurityAlertDedupe {
  id         Int      @id @default(autoincrement())
  ruleKey    String   @db.VarChar(80)
  subjectKey String   @db.VarChar(160)
  firedAt    DateTime @default(now())

  @@unique([ruleKey, subjectKey])
  @@index([firedAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    Int // recipient AppUser
  user      AppUser   @relation(fields: [userId], references: [id])
  /// credit_limit_exceeded | invoice_overdue | invoice_due_soon
  type      String    @db.VarChar(60)
  /// JSON payload: { clienteId?, facturaId?, amount?, limit?, rsocial? }
  payload   Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}

/// @en Expo/device push token for mobile apps (#172; shared with #165).
/// @es Token Expo/dispositivo para apps móviles (#172; compartido con #165).
/// @pt-BR Token Expo/dispositivo para apps móveis (#172; compartilhado com #165).
model DevicePushToken {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    Int
  user      AppUser  @relation(fields: [userId], references: [id])
  token     String   @db.VarChar(255)
  platform  String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@index([tenantId, userId])
}

/// @en Per-user muted push notification types (#172).
/// @es Tipos de push silenciados por usuario (#172).
/// @pt-BR Tipos de push silenciados por usuário (#172).
model PushNotificationPreference {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     Int      @unique
  user       AppUser  @relation(fields: [userId], references: [id])
  mutedTypes String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId])
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  fromUserId Int
  fromUser   AppUser  @relation("ChatMessageSender", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     AppUser  @relation("ChatMessageRecipient", fields: [toUserId], references: [id])
  content    String   @db.VarChar(1000)
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, fromUserId, toUserId, id])
}

/// Tenant withholding/perception agent flags (#228).
model FiscalRetencionesConfig {
  id                         Int      @id @default(autoincrement())
  tenantId                   Int      @unique
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])
  esAgenteRetencionGanancias Boolean  @default(false)
  esAgenteRetencionIVA       Boolean  @default(false)
  esAgenteRetencionIIBB      Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

/// Configurable withholding/perception regime per tenant (#228).
model RegimenRetencion {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  /// ganancias | iva | iibb
  tipo        String   @db.VarChar(20)
  /// retencion | percepcion
  subtipo     String   @db.VarChar(20)
  nombre      String   @db.VarChar(80)
  alicuota    Decimal  @db.Decimal(8, 4)
  alicuotaMin Decimal? @db.Decimal(14, 2)
  provincia   String?  @db.VarChar(10)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  retencionesAplicadas RetencionAplicada[]

  @@index([tenantId, activo])
  @@index([tenantId, tipo, subtipo])
}

/// Applied withholding/perception snapshot (#228; wired by #229/#276).
model RetencionAplicada {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  regimenId     Int
  regimen       RegimenRetencion     @relation(fields: [regimenId], references: [id])
  /// retencion | percepcion
  tipo          String               @db.VarChar(20)
  /// cliente | proveedor
  entidadTipo   String               @db.VarChar(20)
  entidadId     Int
  facturaId     Int?
  factura       Factura?             @relation(fields: [facturaId], references: [id])
  cobroId       Int?
  cobro         Cobro?               @relation(fields: [cobroId], references: [id])
  reciboPagoId  Int?
  reciboPago    ReciboPago?          @relation(fields: [reciboPagoId], references: [id])
  reciboCobroId Int?
  reciboCobro   ReciboCobro?         @relation(fields: [reciboCobroId], references: [id])
  baseImponible Decimal              @db.Decimal(14, 2)
  alicuota      Decimal              @db.Decimal(8, 4)
  importe       Decimal              @db.Decimal(14, 2)
  constanciaNum String?              @db.VarChar(30)
  createdAt     DateTime             @default(now())
  movimientoCC  MovimientoClienteCC?

  @@index([tenantId, createdAt])
  @@index([tenantId, entidadTipo, entidadId])
  @@index([tenantId, tipo])
}

/// Correlative certificate numbers per withholding type (#276).
model RetencionConstanciaSequence {
  id        Int    @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  /// ganancias | iva | iibb
  tipo      String @db.VarChar(20)
  /// Empty string when not province-specific (Ganancias/IVA).
  provincia String @default("") @db.VarChar(10)
  lastNum   Int    @default(0)

  @@unique([tenantId, tipo, provincia])
}

/// Monthly SICORE/SIFERE file generation history (#242).
model PresentacionRetencion {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  /// sicore | sifere
  formato          String    @db.VarChar(10)
  /// YYYY-MM
  periodo          String    @db.VarChar(7)
  totalOperaciones Int
  totalImporte     Decimal   @db.Decimal(14, 2)
  archivoHash      String?   @db.VarChar(64)
  archivoContenido String    @db.Text
  presentadoAt     DateTime?
  createdAt        DateTime  @default(now())
  createdById      Int?
  createdBy        AppUser?  @relation("PresentacionRetencionCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, formato, periodo])
}

/// Tenant bank account for statement import (#190).
model CuentaBancaria {
  id           Int                   @id @default(autoincrement())
  tenantId     Int
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  /// Display bank name (e.g. Galicia, Santander).
  banco        String                @db.VarChar(50)
  /// corriente | caja_ahorro | otra
  tipoCuenta   String                @db.VarChar(20)
  cbu          String                @db.VarChar(22)
  alias        String?               @db.VarChar(60)
  moneda       String                @default("ARS") @db.VarChar(3)
  activo       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  movimientos  MovimientoBancario[]
  periodosLock PeriodoBancarioLock[]

  @@unique([tenantId, cbu])
  @@index([tenantId, activo])
}

/// Imported bank movement with optional collection match (#190/#191).
model MovimientoBancario {
  id               Int            @id @default(autoincrement())
  cuentaId         Int
  cuenta           CuentaBancaria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  fecha            DateTime
  descripcion      String         @db.VarChar(255)
  importe          Decimal        @db.Decimal(14, 2)
  /// debito | credito
  tipo             String         @db.VarChar(10)
  saldo            Decimal?       @db.Decimal(14, 2)
  referencia       String?        @db.VarChar(80)
  /// csv | ofx | mt940
  formatoOrigen    String         @db.VarChar(10)
  dedupeKey        String         @db.VarChar(64)
  /// Logical FK to ReciboCobroForma.id or Cobro.id when matched (#191).
  conciliadoId     Int?
  conciliadoAt     DateTime?
  /// recibo_forma | cobro
  conciliadoTipo   String?        @db.VarChar(20)
  /// unmatched | suggested | matched_auto | matched_manual | ignored | bank_fee
  matchEstado      String         @default("unmatched") @db.VarChar(20)
  matchScore       Decimal?       @db.Decimal(5, 2)
  /// JSON array of suggested candidate ids (tipo+id) when matchEstado=suggested.
  matchSugerencias Json?
  createdAt        DateTime       @default(now())

  @@unique([cuentaId, dedupeKey])
  @@index([cuentaId, fecha])
  @@index([cuentaId, conciliadoAt])
  @@index([cuentaId, matchEstado])
}

/// Locked bank reconciliation period YYYY-MM (#191).
model PeriodoBancarioLock {
  id             Int            @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  cuentaId       Int
  cuenta         CuentaBancaria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  periodo        String         @db.VarChar(7)
  lockedAt       DateTime       @default(now())
  lockedByUserId Int
  lockedByUser   AppUser        @relation(fields: [lockedByUserId], references: [id])

  @@unique([cuentaId, periodo])
  @@index([tenantId, periodo])
}

/// Configurable CSV column mapping per bank code (#190).
model BancoCsvMapping {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  /// galicia | santander | bbva | macro | nacion | custom code
  bancoCode          String   @db.VarChar(30)
  columnaFecha       String   @db.VarChar(60)
  columnaDescripcion String   @db.VarChar(60)
  columnaImporte     String   @db.VarChar(60)
  columnaReferencia  String?  @db.VarChar(60)
  columnaSaldo       String?  @db.VarChar(60)
  /// . | ,
  separadorDecimal   String   @default(",") @db.VarChar(1)
  /// dd/MM/yyyy | yyyy-MM-dd | dd-MM-yyyy
  formatoFecha       String   @default("dd/MM/yyyy") @db.VarChar(20)
  delimiter          String   @default(";") @db.VarChar(1)
  /// signed_importe | tipo_column | credit_positive
  signoDebitoCredito String   @default("signed_importe") @db.VarChar(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, bancoCode])
  @@index([tenantId])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  username  String   @db.VarChar(60)
  ipAddress String?  @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([tenantId, username, createdAt])
}
