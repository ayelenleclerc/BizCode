  devolucionesEntrega              DevolucionEntrega[]
  pedidos                          Pedido[]
  plantillasPedido                 PlantillaPedido[]
  visitasVendedor                  VisitaVendedor[]
  vendedorZonas                    VendedorZona[]
  feriados                         Feriado[]
  rutasVendedor                    RutaVendedor[]
  contratos                        Contrato[]
  ordenesTrabajo                   OrdenTrabajo[]
  garantias                        Garantia[]
  cajas                            Caja[]
  turnosCaja                       TurnoCaja[]
  cobros                           Cobro[]
  cobroRecordatorios               CobroRecordatorio[]
  ordenesEntrega                   OrdenEntrega[]
  remitos                          Remito[]
  cheques                          Cheque[]
  cuentasBancarias                 CuentaBancaria[]
  bancoCsvMappings                 BancoCsvMapping[]
  periodosBancariosLock            PeriodoBancarioLock[]
  repartos                         Reparto[]
  paramEmpresa                     ParamEmpresa?
  fiscalConfig                     TenantFiscalConfig?
  /// @en Multi-organism fiscal provider configs (#378, ADR-0018).
