/// @en Short-lived WhatsApp customer-care bot session (#201); TTL enforced in service (~30 min).
/// @es Sesión corta del bot de atención WhatsApp (#201); TTL en servicio (~30 min).
/// @pt-BR Sessão curta do bot de atendimento WhatsApp (#201); TTL no serviço (~30 min).
model AtencionBotSession {
  id          Int      @id @default(autoincrement())
  /// Digits-only WhatsApp From (no whatsapp: prefix).
  phoneDigits String   @unique @db.VarChar(20)
  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clienteId   Int?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  /// en | es | pt-BR
  locale      String   @default("es") @db.VarChar(10)
  /// await_cuit | null when identity resolved
  pendingStep String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@index([tenantId])
  @@index([clienteId])
}

/// Idempotent Mercado Pago payment webhook processing (#176).
model MercadoPagoProcessedPayment {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  mpPaymentId   String       @db.VarChar(60)
  facturaId     Int?
  factura       Factura?     @relation(fields: [facturaId], references: [id])
  /// approved | rejected | cancelled | pending
  estado        String       @db.VarChar(20)
  reciboCobroId Int?
  reciboCobro   ReciboCobro? @relation(fields: [reciboCobroId], references: [id])
  processedAt   DateTime     @default(now())

  @@unique([tenantId, mpPaymentId])
  @@index([tenantId, facturaId])
}

/// Mercado Pago payments awaiting or completed reconciliation (#178).
model MercadoPagoReconciliationEntry {
  id                  Int          @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  mpPaymentId         String       @db.VarChar(60)
  /// pending | reconciled | ignored
  estado              String       @db.VarChar(20)
  transactionAmount   Decimal      @db.Decimal(14, 2)
  currencyId          String       @default("ARS") @db.VarChar(3)
  paymentDate         DateTime
  payerName           String?      @db.VarChar(120)
  payerEmail          String?      @db.VarChar(120)
  payerIdentification String?      @db.VarChar(20)
  preferenceId        String?      @db.VarChar(60)
  externalReference   String?      @db.VarChar(120)
  facturaId           Int?
  factura             Factura?     @relation(fields: [facturaId], references: [id])
  reciboCobroId       Int?
  reciboCobro         ReciboCobro? @relation(fields: [reciboCobroId], references: [id])
  autoMatched         Boolean      @default(false)
  reconciledByUserId  Int?
  ignoredByUserId     Int?
  reconciledAt        DateTime?
  ignoredAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([tenantId, mpPaymentId])
  @@index([tenantId, estado])
  @@index([tenantId, paymentDate])
}

/// Mercado Pago refund records (#179).
model MercadoPagoRefund {
  id              Int          @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  facturaId       Int
  factura         Factura      @relation(fields: [facturaId], references: [id])
  mpPaymentId     String       @db.VarChar(60)
  mpRefundId      String?      @db.VarChar(60)
  monto           Decimal      @db.Decimal(14, 2)
  motivo          String       @db.VarChar(500)
  /// iniciado | procesando | completado | fallido
  estado          String       @db.VarChar(20)
  notaCreditoId   Int?
  notaCredito     NotaCredito? @relation(fields: [notaCreditoId], references: [id])
  reciboCobroId   Int?
  reciboCobro     ReciboCobro? @relation(fields: [reciboCobroId], references: [id])
  errorMessage    String?      @db.VarChar(500)
  createdByUserId Int?
  createdBy       AppUser?     @relation("MercadoPagoRefundCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, facturaId])
  @@index([tenantId, estado])
  @@index([tenantId, mpPaymentId])
}

/// Mercado Pago chargeback queue (#179).
