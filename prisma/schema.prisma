/// @en Persistent ecommerce sync queue (Prisma worker; no BullMQ) (#189).
/// @es Cola persistente de sync eCommerce (worker Prisma; sin BullMQ) (#189).
/// @pt-BR Fila persistente de sync eCommerce (worker Prisma; sem BullMQ) (#189).
model EcommerceSyncJob {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// meli | tiendanube | woocommerce
  connectorType  String   @db.VarChar(40)
  /// publish_product | update_product | pause_product | update_stock | mark_dispatched
  operation      String   @db.VarChar(40)
  payload        Json
  idempotencyKey String   @unique @db.VarChar(200)
  /// pending | processing | succeeded | failed | dead
  status         String   @default("pending") @db.VarChar(20)
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  nextAttemptAt  DateTime @default(now())
  lastError      String?  @db.Text
  articuloId     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId, connectorType])
  @@index([tenantId, articuloId, operation, status])
}

/// @en Ecommerce sync operation history for configuration UI (#189).
