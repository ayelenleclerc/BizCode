// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  owner
  manager
  seller
  backoffice
  warehouse_op
  warehouse_lead
  logistics_planner
  driver
  billing
  cashier
  collections
  finance
  auditor
}

model DeliveryZone {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  nombre      String   @db.VarChar(60)
  /// barrio | manual | predefinida
  tipo        String   @db.VarChar(20) @default("barrio")
  /// días de entrega separados por coma, e.g. "1,3,5"
  diasEntrega String?  @db.VarChar(20)
  /// horario preferido, e.g. "08:00-12:00"
  horario     String?  @db.VarChar(30)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientes      Cliente[]
  ordenesEntrega OrdenEntrega[]

  @@index([tenantId])
}

model Cliente {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  codigo         Int
  rsocial        String   @db.VarChar(30)
  fantasia       String?  @db.VarChar(30)
  cuit           String?  @db.VarChar(14)
  condIva        String   @db.VarChar(10) // RI, Mono, CF, Exento (aligned with clienteBodySchema / Zod)
  domicilio      String?  @db.VarChar(40)
  localidad      String?  @db.VarChar(25)
  cpost          String?  @db.VarChar(8)
  telef          String?  @db.VarChar(25)
  email          String?  @db.VarChar(50)
  formaPago      Int?     // FK a FormaPago.id
  activo         Boolean  @default(true)
  // ── Financial fields (Issue #31) ──────────────────────────────────────────
  creditLimit    Decimal? @db.Decimal(14, 2)         // null = sin límite; DB: Cliente_creditLimit_nonneg_check
  creditDays     Int      @default(0)                 // días de plazo habituales
  balance        Decimal  @db.Decimal(14, 2) @default(0)  // saldo acumulado
  balanceInicial Decimal  @db.Decimal(14, 2) @default(0)  // saldo al migrar datos
  score          Int      @default(50)               // score de pago 0-100
  suspended      Boolean  @default(false)            // bloquea nuevas ventas
  // ── Logistics (Issue #32) ─────────────────────────────────────────────────
  deliveryZoneId Int?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  // ── Pricing (Issue #234) ──────────────────────────────────────────────────
  /// @en Default price list assigned to this customer; null = base article price (#234).
  /// @es Lista de precios por defecto del cliente; null = precio base del artículo (#234).
  /// @pt-BR Lista de preços padrão do cliente; null = preço base do artigo (#234).
  listaPrecioId  Int?
  listaPrecio    ListaPrecio? @relation(fields: [listaPrecioId], references: [id])
  // ──────────────────────────────────────────────────────────────────────────
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facturas       Factura[]
  pedidos        Pedido[]
  contratos      Contrato[]
  ordenesTrabajo OrdenTrabajo[]
  garantias      Garantia[]
  cobros         Cobro[]
  ordenesEntrega OrdenEntrega[]
  remitos        Remito[]
  cheques        Cheque[]
  movimientosCC  MovimientoClienteCC[]
  recibosCobro   ReciboCobro[]
  portalMagicLinks PortalMagicLink[]
  portalSessions   PortalSession[]
  configsComision ConfigComision[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, codigo])
}

model Rubro {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  codigo   Int
  nombre   String @db.VarChar(20)

  articulos Articulo[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, codigo])
}

/// @en Hierarchical article category (family/subfamily); coexists with flat Rubro (#235).
/// @es Categoría jerárquica de artículos (familia/subfamilia); convive con Rubro plano (#235).
/// @pt-BR Categoria hierárquica de artigos (família/subfamília); convive com Rubro plano (#235).
model CategoriaArticulo {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nombre        String   @db.VarChar(80)
  codigo        String?  @db.VarChar(20)
  padreId       Int?
  padre         CategoriaArticulo?  @relation("CategoriaArbol", fields: [padreId], references: [id])
  hijos         CategoriaArticulo[] @relation("CategoriaArbol")
  /// @en Optional default list price for category-level inheritance.
  /// @es Precio de lista opcional por defecto para herencia a nivel categoría.
  /// @pt-BR Preço de lista opcional padrão para herança em nível de categoria.
  precioDefault Decimal? @db.Decimal(14, 2)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atributos CategoriaAtributo[]
  articulos Articulo[]
  configsComision ConfigComision[]

  @@index([tenantId])
  @@index([tenantId, padreId])
  @@index([tenantId, activo])
}

/// @en Variant attribute definition on a category (e.g. Color, Size) (#235).
/// @es Definición de atributo de variante en una categoría (ej. Color, Talle) (#235).
/// @pt-BR Definição de atributo de variante em uma categoria (ex.: Cor, Tamanho) (#235).
model CategoriaAtributo {
  id          Int               @id @default(autoincrement())
  tenantId    Int
  categoriaId Int
  categoria   CategoriaArticulo @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String            @db.VarChar(40)
  orden       Int               @default(0)

  valores CategoriaAtributoValor[]

  @@unique([categoriaId, nombre])
  @@index([tenantId])
  @@index([categoriaId])
}

/// @en Allowed value for a category attribute (e.g. Red, S) (#235).
/// @es Valor permitido de un atributo de categoría (ej. Rojo, S) (#235).
/// @pt-BR Valor permitido de um atributo de categoria (ex.: Vermelho, P) (#235).
model CategoriaAtributoValor {
  id         Int               @id @default(autoincrement())
  atributoId Int
  atributo   CategoriaAtributo @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  valor      String            @db.VarChar(40)
  orden      Int               @default(0)

  articuloValores ArticuloAtributoValor[]

  @@unique([atributoId, valor])
  @@index([atributoId])
}

/// @en Links a variant article to one selected attribute value (#235).
/// @es Vincula un artículo variante a un valor de atributo seleccionado (#235).
/// @pt-BR Vincula um artigo variante a um valor de atributo selecionado (#235).
model ArticuloAtributoValor {
  id              Int                   @id @default(autoincrement())
  articuloId      Int
  articulo        Articulo              @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  atributoValorId Int
  atributoValor   CategoriaAtributoValor @relation(fields: [atributoValorId], references: [id], onDelete: Restrict)

  @@unique([articuloId, atributoValorId])
  @@index([articuloId])
  @@index([atributoValorId])
}

/// @en Local disk image for an article/variant (thumb/medium/original) (#235).
/// @es Imagen en disco local de un artículo/variante (thumb/medium/original) (#235).
/// @pt-BR Imagem em disco local de um artigo/variante (thumb/medium/original) (#235).
model ArticuloImagen {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  articuloId   Int
  articulo     Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  pathOriginal String   @db.VarChar(260)
  pathMedium   String   @db.VarChar(260)
  pathThumb    String   @db.VarChar(260)
  orden        Int      @default(0)
  esPrincipal  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tenantId, articuloId])
  @@index([articuloId, orden])
}

/// @en Temporary offer price for a sellable variant (#235).
/// @es Precio de oferta temporal para una variante vendible (#235).
/// @pt-BR Preço de oferta temporária para uma variante vendável (#235).
model ArticuloOferta {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  articuloId     Int
  articulo       Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  precioOferta   Decimal  @db.Decimal(14, 2)
  vigenciaDesde  DateTime
  vigenciaHasta  DateTime
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, articuloId])
  @@index([articuloId, activa])
}

model Articulo {
  id           Int    @id @default(autoincrement())
  tenantId     Int
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  codigo       Int
  /// @en Widened for variant labels such as "Remera - Roja - S" (#235).
  /// @es Ampliado para etiquetas de variante como "Remera - Roja - S" (#235).
  /// @pt-BR Ampliado para rótulos de variante como "Camiseta - Vermelha - P" (#235).
  descripcion  String @db.VarChar(120)
  rubroId      Int
  rubro        Rubro  @relation(fields: [rubroId], references: [id])
  /// @en Optional hierarchical category; Rubro remains required (#235).
  /// @es Categoría jerárquica opcional; Rubro sigue siendo obligatorio (#235).
  /// @pt-BR Categoria hierárquica opcional; Rubro continua obrigatório (#235).
  categoriaId  Int?
  categoria    CategoriaArticulo? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  /// @en True when this row is a parent that owns generated variants (#235).
  /// @es True cuando esta fila es un padre que posee variantes generadas (#235).
  /// @pt-BR True quando esta linha é um pai que possui variantes geradas (#235).
  esPadre      Boolean @default(false)
  padreId      Int?
  padre        Articulo?  @relation("ArticuloVariantes", fields: [padreId], references: [id], onDelete: Restrict)
  variantes    Articulo[] @relation("ArticuloVariantes")
  /// @en When true, catalog price inherits from parent/category cascade; when false use precioOverride or materialized precioLista1 (#235).
  /// @es Si true, el precio de catálogo hereda de padre/categoría; si false usa precioOverride o precioLista1 materializado (#235).
  /// @pt-BR Se true, o preço de catálogo herda do pai/categoria; se false usa precioOverride ou precioLista1 materializado (#235).
  heredaPrecio Boolean @default(true)
  precioOverride Decimal? @db.Decimal(14, 2)
  costoOverride  Decimal? @db.Decimal(13, 2)
  condIva      String @db.VarChar(1) // IVA %: 1=21%, 2=10.5%, 3=Exento
  umedida      String @db.VarChar(6)
  /// @en Catalog item kind: physical article vs service without stock (#244).
  /// @es Tipo de ítem de catálogo: artículo físico vs servicio sin stock (#244).
  /// @pt-BR Tipo de item de catálogo: artigo físico vs serviço sem estoque (#244).
  tipo         String @default("articulo") @db.VarChar(10) // articulo | servicio
  /// @en Service unit when tipo=servicio (hora, dia, mes, …).
  /// @es Unidad de servicio cuando tipo=servicio (hora, dia, mes, …).
  /// @pt-BR Unidade de serviço quando tipo=serviço (hora, dia, mes, …).
  unidadServicio String? @db.VarChar(12)
  /// @en Warranty months for physical articles; null = no warranty (#251).
  /// @es Meses de garantía para artículos físicos; null = sin garantía (#251).
  /// @pt-BR Meses de garantia para artigos físicos; null = sem garantia (#251).
  mesesGarantia Int?
  precioLista1 Decimal @db.Decimal(14, 2)
  precioLista2 Decimal @db.Decimal(14, 2)
  costo        Decimal @db.Decimal(13, 2)
  stock        Int    @default(0) // DB: Articulo_stock_nonneg_check
  minimo       Int    @default(0) // DB: Articulo_minimo_nonneg_check
  activo       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facturaItems     FacturaItem[]
  pedidoItems      PedidoItem[]
  contratoItems    ContratoItem[]
  ordenTrabajoItems OrdenTrabajoItem[]
  remitoItems      RemitoItem[]
  stockAjustes     StockAjuste[]
  stockDepositos   StockDeposito[]
  transferenciaItems TransferenciaDepositoItem[]
  ordenCompraItems     OrdenCompraItem[]
  recuentoItems        RecuentoItem[]
  proveedorArticulos   ProveedorArticulo[]
  garantias            Garantia[]
  listaPrecioItems     ListaPrecioItem[]
  atributoValores      ArticuloAtributoValor[]
  imagenes             ArticuloImagen[]
  ofertas              ArticuloOferta[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, codigo])
  @@index([tenantId, rubroId])
  @@index([tenantId, tipo])
  @@index([tenantId, padreId])
  @@index([tenantId, categoriaId])
  @@index([tenantId, esPadre])
}

/// @en Physical warehouse / stock location for a tenant (#236).
/// @es Depósito / ubicación de stock de un tenant (#236).
/// @pt-BR Depósito / localização de estoque de um tenant (#236).
model Deposito {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  nombre         String   @db.VarChar(80)
  codigo         String   @db.VarChar(20)
  /// central | sucursal | externo | picking | transito
  tipo           String   @db.VarChar(20)
  direccion      String?  @db.VarChar(200)
  responsableId  Int?
  responsable    AppUser? @relation("DepositoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  activo         Boolean  @default(true)
  esDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockRows          StockDeposito[]
  transferenciasOrigen  TransferenciaDeposito[] @relation("TransfOrigen")
  transferenciasDestino TransferenciaDeposito[] @relation("TransfDestino")
  facturas           Factura[]
  pedidos            Pedido[]
  ordenesCompra      OrdenCompra[]
  stockAjustes       StockAjuste[]
  recuentos          Recuento[]
  ordenesEntrega     OrdenEntrega[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, activo])
  @@index([tenantId, esDefault])
}

/// @en Stock quantity of one article inside one deposit (#236). Articulo.stock is the sum cache.
/// @es Cantidad de stock de un artículo en un depósito (#236). Articulo.stock es la suma cacheada.
/// @pt-BR Quantidade de estoque de um artigo em um depósito (#236). Articulo.stock é a soma em cache.
model StockDeposito {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  articuloId Int
  articulo   Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  depositoId Int
  deposito   Deposito @relation(fields: [depositoId], references: [id], onDelete: Restrict)
  cantidad   Int      @default(0)
  stockMin   Int      @default(0)
  stockMax   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([articuloId, depositoId])
  @@index([tenantId])
  @@index([tenantId, depositoId])
  @@index([tenantId, articuloId])
}

/// @en Inter-warehouse transfer header (#236).
/// @es Cabecera de transferencia entre depósitos (#236).
/// @pt-BR Cabeçalho de transferência entre depósitos (#236).
model TransferenciaDeposito {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  numero         Int
  origenId       Int
  origen         Deposito  @relation("TransfOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId      Int
  destino        Deposito  @relation("TransfDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  /// pendiente | en_transito | recibida | anulada
  estado         String    @db.VarChar(20) @default("pendiente")
  solicitadoPorId Int
  solicitadoPor  AppUser   @relation("TransferenciaSolicitadoPor", fields: [solicitadoPorId], references: [id])
  aprobadoPorId  Int?
  aprobadoPor    AppUser?  @relation("TransferenciaAprobadoPor", fields: [aprobadoPorId], references: [id])
  fechaEnvio     DateTime?
  fechaRecepcion DateTime?
  nota           String?   @db.VarChar(200)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items TransferenciaDepositoItem[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, origenId])
  @@index([tenantId, destinoId])
}

/// @en Line item of an inter-warehouse transfer (#236).
/// @es Ítem de una transferencia entre depósitos (#236).
/// @pt-BR Item de uma transferência entre depósitos (#236).
model TransferenciaDepositoItem {
  id                Int                   @id @default(autoincrement())
  transferenciaId   Int
  transferencia     TransferenciaDeposito @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  articuloId        Int
  articulo          Articulo              @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidadEnviada   Int
  cantidadRecibida  Int?

  @@unique([transferenciaId, articuloId])
  @@index([transferenciaId])
  @@index([articuloId])
}

/// @en Customer price list with optional currency and expiry (#234).
/// @es Lista de precios de cliente con moneda y vigencia opcionales (#234).
/// @pt-BR Lista de preços de cliente com moeda e validade opcionais (#234).
model ListaPrecio {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nombre        String   @db.VarChar(80)
  /// @en ISO currency code for the list (default ARS).
  /// @es Código ISO de moneda de la lista (por defecto ARS).
  /// @pt-BR Código ISO da moeda da lista (padrão ARS).
  moneda        String   @default("ARS") @db.VarChar(3)
  activa        Boolean  @default(true)
  /// @en Base list used as fallback when a customer has no list assigned.
  /// @es Lista base usada como respaldo cuando el cliente no tiene lista asignada.
  /// @pt-BR Lista base usada como fallback quando o cliente não tem lista atribuída.
  esDefault     Boolean  @default(false)
  /// @en Expiry date; null = no expiry. Expired lists fall back to base price (#234).
  /// @es Fecha de vencimiento; null = sin vencimiento. Listas vencidas usan precio base (#234).
  /// @pt-BR Data de expiração; null = sem expiração. Listas expiradas usam preço base (#234).
  vigenciaHasta DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         ListaPrecioItem[]
  clientes      Cliente[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@index([tenantId, activa])
}

/// @en Price of one article inside a price list: fixed value or percent over the base article price (#234).
/// @es Precio de un artículo dentro de una lista: valor fijo o porcentaje sobre el precio base del artículo (#234).
/// @pt-BR Preço de um artigo dentro de uma lista: valor fixo ou percentual sobre o preço base do artigo (#234).
model ListaPrecioItem {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  listaPrecioId Int
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  articuloId    Int
  articulo      Articulo    @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  /// fijo | porcentaje_sobre_base
  tipoPrecio    String      @db.VarChar(24)
  /// @en Fixed price when tipoPrecio=fijo.
  /// @es Precio fijo cuando tipoPrecio=fijo.
  /// @pt-BR Preço fixo quando tipoPrecio=fijo.
  precio        Decimal?    @db.Decimal(14, 2)
  /// @en Percentage over base price when tipoPrecio=porcentaje_sobre_base (e.g. -15 = 15% discount).
  /// @es Porcentaje sobre precio base cuando tipoPrecio=porcentaje_sobre_base (ej: -15 = 15% descuento).
  /// @pt-BR Percentual sobre o preço base quando tipoPrecio=porcentaje_sobre_base (ex.: -15 = 15% desconto).
  porcentaje    Decimal?    @db.Decimal(7, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  escalonados   PrecioEscalonado[]

  @@unique([listaPrecioId, articuloId])
  @@index([tenantId])
  @@index([listaPrecioId])
  @@index([articuloId])
}

/// @en Quantity-tiered price for a price-list item; the matching tier overrides the item price (#234).
/// @es Precio escalonado por cantidad para un ítem de lista; el tramo coincidente pisa el precio del ítem (#234).
/// @pt-BR Preço escalonado por quantidade para um item de lista; a faixa correspondente sobrepõe o preço do item (#234).
model PrecioEscalonado {
  id                Int             @id @default(autoincrement())
  listaPrecioItemId Int
  listaPrecioItem   ListaPrecioItem @relation(fields: [listaPrecioItemId], references: [id], onDelete: Cascade)
  cantidadDesde     Decimal         @db.Decimal(14, 2)
  /// @en Upper bound (inclusive); null = no upper limit.
  /// @es Límite superior (inclusive); null = sin límite superior.
  /// @pt-BR Limite superior (inclusive); null = sem limite superior.
  cantidadHasta     Decimal?        @db.Decimal(14, 2)
  precio            Decimal         @db.Decimal(14, 2)

  @@index([listaPrecioItemId])
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  codigo    Int
  rsocial   String   @db.VarChar(30)
  fantasia  String?  @db.VarChar(30)
  cuit      String?  @db.VarChar(14)
  condIva   String   @db.VarChar(10)
  telef     String?  @db.VarChar(25)
  email     String?  @db.VarChar(50)
  activo    Boolean  @default(true)
  cbu            String?  @db.VarChar(22)
  alias          String?  @db.VarChar(20)
  banco          String?  @db.VarChar(50)
  tipoCuenta     String?  @db.VarChar(2)
  moneda         String   @default("ARS") @db.VarChar(3)
  condicionPago  String?  @db.VarChar(10)
  plazoHabitual  Int?
  descuentoPct   Decimal? @db.Decimal(5, 2)
  limiteCredito  Decimal? @db.Decimal(14, 2)
  categoria      String?  @db.VarChar(20)
  contactoNombre String?  @db.VarChar(50)
  contactoEmail  String?  @db.VarChar(50)
  contactoTel    String?  @db.VarChar(25)
  notas          String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordenesCompra            OrdenCompra[]
  comprobantesCompra       ComprobanteCompra[]
  movimientosCuentaCorriente MovimientoProveedorCC[]
  recibosPago              ReciboPago[]
  catalogoArticulos        ProveedorArticulo[]
  remitos                  Remito[]
  cheques                  Cheque[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, codigo])
  @@index([tenantId, activo])
  @@index([tenantId, categoria])
}

/// Supplier-specific product codes and list prices (#273).
model ProveedorArticulo {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  proveedorId      Int
  proveedor        Proveedor @relation(fields: [proveedorId], references: [id])
  articuloId       Int
  articulo         Articulo  @relation(fields: [articuloId], references: [id])
  codigoProveedor  String    @db.VarChar(50)
  descripcion      String?   @db.VarChar(120)
  precioLista      Decimal?  @db.Decimal(14, 2)
  precioListaFecha DateTime?
  unidadCompra     String?   @db.VarChar(30)
  multiplo         Decimal   @default(1) @db.Decimal(10, 2)
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, proveedorId, articuloId])
  @@unique([tenantId, proveedorId, codigoProveedor])
  @@index([tenantId, proveedorId])
  @@index([tenantId, articuloId])
}

model OrdenCompra {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  /// draft | sent | received | cancelled
  estado        String   @db.VarChar(20) @default("draft")
  total         Decimal  @db.Decimal(14, 2) @default(0)
  fechaEstimada DateTime?
  nota          String?  @db.VarChar(200)
  /// @en Destination deposit for goods receipt when inventory.warehouses is enabled (#236).
  /// @es Depósito destino de la recepción cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito destino da recepção quando inventory.warehouses está ativo (#236).
  depositoId    Int?
  deposito      Deposito? @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items              OrdenCompraItem[]
  comprobantesCompra ComprobanteCompra[]

  @@index([tenantId, estado])
  @@index([tenantId, proveedorId])
  @@index([tenantId, depositoId])
}

/// Supplier fiscal voucher for Libro IVA Compras (#306, ADR-0014).
model ComprobanteCompra {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  proveedorId   Int
  proveedor     Proveedor   @relation(fields: [proveedorId], references: [id])
  ordenCompraId Int?
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  fecha         DateTime
  /// Explicit due date; when null, derived from proveedor plazo (#275).
  vencimiento   DateTime?
  tipo          String      @db.VarChar(1)
  prefijo       String      @db.VarChar(4)
  numero        Int
  neto1         Decimal     @db.Decimal(14, 2) @default(0)
  neto2         Decimal     @db.Decimal(14, 2) @default(0)
  neto3         Decimal     @db.Decimal(14, 2) @default(0)
  iva1          Decimal     @db.Decimal(14, 2) @default(0)
  iva2          Decimal     @db.Decimal(14, 2) @default(0)
  total         Decimal     @db.Decimal(14, 2) @default(0)
  cae           String?     @db.VarChar(20)
  caeVto        DateTime?
  /// A=active (included in libro compras)
  estado        String      @db.VarChar(1) @default("A")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  movimientoCuentaCorriente MovimientoProveedorCC?
  reciboPagoFacturas       ReciboPagoFactura[]
  alertasProveedor         AlertaProveedorLog[]
  documentoImportado       DocumentoCompraImportado?

  @@unique([tenantId, tipo, prefijo, numero])
  @@index([tenantId, fecha])
  @@index([tenantId, proveedorId])
  @@index([tenantId, estado, fecha])
}

/// Imported purchase document (PDF/image) pending review (#277).
model DocumentoCompraImportado {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  usuarioId           Int
  usuario             AppUser            @relation(fields: [usuarioId], references: [id])
  archivoNombre       String             @db.VarChar(255)
  archivoMime         String             @db.VarChar(100)
  archivoPath         String             @db.VarChar(500)
  tipoArchivo         String             @db.VarChar(10)
  tier                Int                @default(0)
  confianza           Decimal            @db.Decimal(3, 2) @default(0)
  /// procesando | pendiente_revision | confirmado | descartado
  estado              String             @db.VarChar(30)
  datosExtraidos      Json
  comprobanteCompraId Int?               @unique
  comprobanteCompra   ComprobanteCompra? @relation(fields: [comprobanteCompraId], references: [id])
  errores             Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId, estado])
  @@index([tenantId, usuarioId])
}

model OrdenCompraItem {
  id                   Int         @id @default(autoincrement())
  ordenCompraId        Int
  ordenCompra          OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  articuloId           Int
  articulo             Articulo    @relation(fields: [articuloId], references: [id])
  /// Supplier catalog code snapshot at PO create/update (#323).
  codigoProveedor      String?     @db.VarChar(50)
  /// Supplier catalog description snapshot at PO create/update (#323).
  descripcionProveedor String?     @db.VarChar(120)
  cantidad             Int
  cantidadRecibida     Int         @default(0)
  costoUnitario        Decimal     @db.Decimal(14, 2)
  subtotal             Decimal     @db.Decimal(14, 2)

  @@index([ordenCompraId])
  @@index([articuloId])
}

model Recuento {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  operadorId Int
  operador   AppUser   @relation("RecuentoOperador", fields: [operadorId], references: [id])
  /// in_progress | closed
  estado     String    @db.VarChar(20) @default("in_progress")
  fecha      DateTime  @default(now())
  closedAt   DateTime?
  /// @en Deposit counted when inventory.warehouses is enabled (#236).
  /// @es Depósito contado cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito contado quando inventory.warehouses está ativo (#236).
  depositoId Int?
  deposito   Deposito? @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items RecuentoItem[]

  @@index([tenantId, estado])
  @@index([tenantId, depositoId, estado])
}

model RecuentoItem {
  id          Int      @id @default(autoincrement())
  recuentoId  Int
  recuento    Recuento @relation(fields: [recuentoId], references: [id], onDelete: Cascade)
  articuloId  Int
  articulo    Articulo @relation(fields: [articuloId], references: [id])
  cantSistema Int
  cantFisica  Int?

  @@unique([recuentoId, articuloId])
  @@index([recuentoId])
  @@index([articuloId])
}

model FormaPago {
  id          Int     @id @default(autoincrement())
  codigo      Int     @unique
  descripcion String  @db.VarChar(25)
  vto_dias    Int     @default(0)
  /// When true, Cobro/Factura with this form auto-posts MovimientoCaja on open shift (#247).
  esEfectivo  Boolean @default(false)
  cobros      Cobro[]
}

model Cobro {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  clienteId   Int
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  fecha       DateTime
  monto       Decimal   @db.Decimal(14, 2)
  formaPagoId Int?
  formaPago   FormaPago? @relation(fields: [formaPagoId], references: [id])
  chequeId    Int?
  cheque      Cheque?   @relation(fields: [chequeId], references: [id])
  referencia  String?   @db.VarChar(60)
  nota        String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  retencionesAplicadas RetencionAplicada[]
  movimientoCC         MovimientoClienteCC?

  @@index([tenantId, clienteId])
  @@index([tenantId, fecha])
}

model CobroRecordatorio {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  facturaId Int
  factura   Factura  @relation(fields: [facturaId], references: [id])
  canal     String   @db.VarChar(20)
  enviadoAt DateTime @default(now())

  @@index([tenantId, facturaId, enviadoAt])
}

model Factura {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  fecha     DateTime
  tipo      String    @db.VarChar(1) // A, B, C, X
  prefijo   String    @db.VarChar(4)
  numero    Int
  clienteId Int
  cliente   Cliente   @relation(fields: [clienteId], references: [id])

  neto1     Decimal   @db.Decimal(14, 2) @default(0)  // Neto IVA 21%
  neto2     Decimal   @db.Decimal(14, 2) @default(0)  // Neto IVA 10.5%
  neto3     Decimal   @db.Decimal(14, 2) @default(0)  // Neto exento
  iva1      Decimal   @db.Decimal(14, 2) @default(0)  // IVA 21%
  iva2      Decimal   @db.Decimal(14, 2) @default(0)  // IVA 10.5%
  total     Decimal   @db.Decimal(14, 2) @default(0)

  formaPagoId Int?
  cae           String?   @db.VarChar(20)
  caeVto        DateTime?
  estadoCae     String    @db.VarChar(20) @default("pending")
  estado    String    @db.VarChar(1) @default("A") // A=activa, A=anulada
  /// Mercado Pago checkout preference (#175)
  mpPreferenceId        String?   @db.VarChar(60)
  mpPaymentLink         String?   @db.VarChar(500)
  mpEstado              String?   @db.VarChar(20)
  mpPagadoAt            DateTime?
  mpPreferenceExpiresAt DateTime?
  /// Mercado Pago instore dynamic QR (#177)
  mpQrData              String?   @db.Text
  mpQrOrderId           String?   @db.VarChar(60)
  mpQrExpiresAt         DateTime?
  /// @en Dispatch deposit when inventory.warehouses is enabled (#236).
  /// @es Depósito de despacho cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito de despacho quando inventory.warehouses está ativo (#236).
  depositoId            Int?
  deposito              Deposito? @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Recurring contract that generated this invoice (#245); null for ad-hoc sales.
  contratoId  Int?
  contrato    Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  items          FacturaItem[]
  ordenesEntrega OrdenEntrega[]
  ordenesTrabajo OrdenTrabajo[]
  garantias      Garantia[]
  recordatorios  CobroRecordatorio[]
  pedido         Pedido?
  notasCredito   NotaCredito[]
  retencionesAplicadas RetencionAplicada[]
  remitos        Remito[]
  movimientoCC   MovimientoClienteCC?
  reciboCobroImputaciones ReciboCobroImputacion[]
  mercadoPagoProcessedPayments MercadoPagoProcessedPayment[]
  mercadoPagoReconciliationEntries MercadoPagoReconciliationEntry[]
  mercadoPagoRefunds           MercadoPagoRefund[]
  mercadoPagoChargebacks       MercadoPagoChargeback[]
  liquidacionComisionDetalles  LiquidacionComisionDetalle[]

  @@unique([tenantId, tipo, prefijo, numero])
  @@index([tenantId])
  @@index([tenantId, fecha])
  @@index([tenantId, estado, fecha])
  @@index([tenantId, clienteId])
  @@index([tenantId, contratoId])
  @@index([tenantId, depositoId])
}

/// Recurring service contract with scheduled invoicing (#245).
model Contrato {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  numero      Int
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.VarChar(500)
  /// activo | pausado | finalizado | cancelado
  estado      String   @db.VarChar(20) @default("activo")
  /// mensual | bimestral | trimestral | semestral | anual
  frecuencia  String   @db.VarChar(20) @default("mensual")
  diaDelMes   Int      @default(1)
  fechaInicio DateTime
  fechaFin    DateTime?
  proximaFact DateTime
  montoBase   Decimal  @db.Decimal(14, 2) @default(0)
  moneda      String   @default("ARS") @db.VarChar(3)
  incluyeIVA  Boolean  @default(false)
  ivaAlicuota Decimal  @db.Decimal(5, 2) @default(21)
  /// auto = create invoice + current CAE flow; revision = create invoice without ARCA (#245).
  modoEmision String   @default("revision") @db.VarChar(20)
  tipoFactura String   @default("B") @db.VarChar(1)
  prefijo     String   @default("0001") @db.VarChar(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    ContratoItem[]
  ajuste   ContratoAjuste?
  facturas Factura[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, proximaFact])
  @@index([tenantId, clienteId])
}

model ContratoItem {
  id             Int       @id @default(autoincrement())
  contratoId     Int
  contrato       Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  articuloId     Int?
  articulo       Articulo? @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  descripcion    String    @db.VarChar(120)
  condIva        String    @default("1") @db.VarChar(1)
  unidadServicio String?   @db.VarChar(12)
  cantidad       Int       @default(1)
  precioUnit     Decimal   @db.Decimal(14, 2)
  dscto          Decimal   @db.Decimal(5, 2) @default(0)
  createdAt      DateTime  @default(now())

  @@index([contratoId])
}

/// Price adjustment schedule for a contract (#245). IPC/ICL HTTP deferred; porcentaje_fijo | manual only.
model ContratoAjuste {
  id               Int      @id @default(autoincrement())
  contratoId       Int      @unique
  contrato         Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  /// porcentaje_fijo | manual
  tipo             String   @db.VarChar(20)
  porcentaje       Decimal? @db.Decimal(8, 4)
  /// mensual | bimestral | trimestral | semestral | anual
  frecuenciaAjuste String   @db.VarChar(20)
  proximoAjuste    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Service work order / repair ticket (#246).
model OrdenTrabajo {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  numero             Int
  clienteId          Int
  cliente            Cliente   @relation(fields: [clienteId], references: [id])
  tecnicoId          Int?
  tecnico            AppUser?  @relation("OrdenTrabajoTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  /// recibido | diagnosticado | presupuestado | aprobado | en_reparacion | listo | entregado | facturado | cancelado | sin_reparacion
  estado             String    @default("recibido") @db.VarChar(20)
  /// baja | normal | alta | urgente
  prioridad          String    @default("normal") @db.VarChar(12)
  equipoMarca        String?   @db.VarChar(60)
  equipoModelo       String?   @db.VarChar(60)
  equipoNroSerie     String?   @db.VarChar(80)
  equipoDescripcion  String    @db.VarChar(200)
  sintomaReportado   String    @db.VarChar(500)
  diagnostico        String?   @db.VarChar(1000)
  trabajoRealizado   String?   @db.VarChar(1000)
  enGarantia         Boolean   @default(false)
  garantiaVence      DateTime?
  otGarantiaId       Int?
  otGarantia         OrdenTrabajo?  @relation("OtGarantiaOrigen", fields: [otGarantiaId], references: [id], onDelete: SetNull)
  otsEnGarantia      OrdenTrabajo[] @relation("OtGarantiaOrigen")
  /// Formal warranty record used for this OT (#251).
  garantiaId         Int?
  garantia           Garantia? @relation(fields: [garantiaId], references: [id], onDelete: SetNull)
  presupuesto        Decimal?  @db.Decimal(14, 2)
  fechaIngreso       DateTime  @default(now())
  fechaPromesa       DateTime?
  fechaEntrega       DateTime?
  facturaId          Int?
  factura            Factura?  @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  observaciones      String?   @db.VarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items OrdenTrabajoItem[]
  garantiaUsos GarantiaUso[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, tecnicoId])
  @@index([tenantId, equipoNroSerie])
  @@index([tenantId, facturaId])
  @@index([tenantId, garantiaId])
}

/// Product warranty registered at sale (#251).
model Garantia {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  facturaId         Int?
  factura           Factura?  @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  facturaItemId     Int?
  facturaItem       FacturaItem? @relation(fields: [facturaItemId], references: [id], onDelete: SetNull)
  articuloId        Int
  articulo          Articulo  @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  nroSerie          String?   @db.VarChar(80)
  nroImei           String?   @db.VarChar(20)
  descripcionEquipo String?   @db.VarChar(200)
  clienteId         Int
  cliente           Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fechaVenta        DateTime
  mesesGarantia     Int
  fechaVencimiento  DateTime
  /// vigente | vencida | anulada
  estado            String    @default("vigente") @db.VarChar(12)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  usos          GarantiaUso[]
  ordenesTrabajo OrdenTrabajo[]

  @@index([tenantId, nroSerie])
  @@index([tenantId, nroImei])
  @@index([tenantId, clienteId])
  @@index([tenantId, fechaVencimiento])
  @@index([tenantId, estado])
  @@index([tenantId, articuloId])
  @@index([facturaId])
  @@index([facturaItemId])
}

/// Warranty claim / usage linked to a work order (#251).
model GarantiaUso {
  id          Int          @id @default(autoincrement())
  garantiaId  Int
  garantia    Garantia     @relation(fields: [garantiaId], references: [id], onDelete: Cascade)
  otId        Int?
  ordenTrabajo OrdenTrabajo? @relation(fields: [otId], references: [id], onDelete: SetNull)
  descripcion String       @db.VarChar(500)
  fecha       DateTime     @default(now())
  userId      Int
  user        AppUser      @relation("GarantiaUsoUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([garantiaId])
  @@index([otId])
  @@index([userId])
}

/// Cash register drawer for POS shifts (#247).
model Caja {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nombre    String   @db.VarChar(80)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turnos    TurnoCaja[]

  @@unique([tenantId, nombre])
  @@index([tenantId, activa])
}

/// Cashier shift on a drawer (#247).
model TurnoCaja {
  id                    Int       @id @default(autoincrement())
  tenantId              Int
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  cajaId                Int
  caja                  Caja      @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  cajeroId              Int
  cajero                AppUser   @relation("TurnoCajaCajero", fields: [cajeroId], references: [id], onDelete: Restrict)
  /// abierto | cerrado
  estado                String    @db.VarChar(12)
  montoApertura         Decimal   @db.Decimal(14, 2)
  fechaApertura         DateTime  @default(now())
  fechaCierre           DateTime?
  totalVentasEfectivo   Decimal?  @db.Decimal(14, 2)
  totalVentasTarjeta    Decimal?  @db.Decimal(14, 2)
  totalVentasMP         Decimal?  @db.Decimal(14, 2)
  totalVentasTransf     Decimal?  @db.Decimal(14, 2)
  totalEgresos          Decimal?  @db.Decimal(14, 2)
  totalIngresosExtra    Decimal?  @db.Decimal(14, 2)
  efectivoEsperado      Decimal?  @db.Decimal(14, 2)
  efectivoContado       Decimal?  @db.Decimal(14, 2)
  diferencia            Decimal?  @db.Decimal(14, 2)
  observaciones         String?   @db.VarChar(500)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  conteo                ConteoEfectivo?
  movimientos           MovimientoCaja[]

  @@index([tenantId, estado])
  @@index([tenantId, cajaId])
  @@index([tenantId, cajeroId])
  @@index([tenantId, fechaApertura])
}

/// Physical cash count by ARS denomination at shift close (#247).
model ConteoEfectivo {
  id      Int       @id @default(autoincrement())
  turnoId Int       @unique
  turno   TurnoCaja @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  b1000   Int       @default(0)
  b500    Int       @default(0)
  b200    Int       @default(0)
  b100    Int       @default(0)
  b50     Int       @default(0)
  b20     Int       @default(0)
  b10     Int       @default(0)
  m10     Int       @default(0)
  m5      Int       @default(0)
  m2      Int       @default(0)
  m1      Int       @default(0)
  total   Decimal   @db.Decimal(14, 2)
}

/// Cash drawer movement during a shift (#247).
model MovimientoCaja {
  id             Int       @id @default(autoincrement())
  turnoId        Int
  turno          TurnoCaja @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  /// venta | cobro | egreso | ingreso_extra
  tipo           String    @db.VarChar(20)
  /// efectivo | tarjeta | mp | transferencia | otro
  formaPago      String    @db.VarChar(20)
  importe        Decimal   @db.Decimal(14, 2)
  concepto       String?   @db.VarChar(200)
  /// factura | cobro | recibo_cobro
  referenciaTipo String?   @db.VarChar(20)
  referenciaId   Int?
  userId         Int
  user           AppUser   @relation("MovimientoCajaUser", fields: [userId], references: [id], onDelete: Restrict)
  fecha          DateTime  @default(now())

  @@index([turnoId])
  @@index([userId])
  @@index([referenciaTipo, referenciaId])
}

model OrdenTrabajoItem {
  id          Int          @id @default(autoincrement())
  otId        Int
  ordenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)
  /// mano_de_obra | repuesto | servicio
  tipo        String       @db.VarChar(20)
  descripcion String       @db.VarChar(120)
  articuloId  Int?
  articulo    Articulo?    @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad    Decimal      @db.Decimal(14, 4)
  precioUnit  Decimal      @db.Decimal(14, 2)
  subtotal    Decimal      @db.Decimal(14, 2)
  condIva     String       @default("1") @db.VarChar(1)
  createdAt   DateTime     @default(now())

  @@index([otId])
  @@index([articuloId])
}


/// Credit note issued when voiding an invoice (GitHub #146, ADR-0012).
model NotaCredito {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  facturaOrigenId Int
  facturaOrigen   Factura   @relation(fields: [facturaOrigenId], references: [id])
  motivo          String    @db.VarChar(500)
  monto           Decimal   @db.Decimal(14, 2)
  cae             String?   @db.VarChar(20)
  caeVto          DateTime?
  /// pending | issued | failed | not_required (ADR-0012)
  estadoCae       String    @db.VarChar(20) @default("pending")
  createdById     Int?
  createdBy       AppUser?  @relation("NotaCreditoCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  movimientoCC    MovimientoClienteCC?
  mercadoPagoRefunds MercadoPagoRefund[]

  @@index([tenantId, createdAt])
  @@index([tenantId, facturaOrigenId])
}

model Pedido {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  clienteId   Int
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  vendedorId  Int?
  vendedor    AppUser?  @relation(fields: [vendedorId], references: [id])
  /// draft | confirmed | invoiced | cancelled (ADR-0009)
  estado      String    @db.VarChar(20)
  total       Decimal   @db.Decimal(14, 2) @default(0)
  validUntil  DateTime?
  facturaId   Int?      @unique
  factura     Factura?  @relation(fields: [facturaId], references: [id])
  /// @en Intended dispatch deposit when inventory.warehouses is enabled (#236).
  /// @es Depósito de despacho previsto cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito de despacho previsto quando inventory.warehouses está ativo (#236).
  depositoId  Int?
  deposito    Deposito? @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  remito      Remito?
  items       PedidoItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, depositoId])
}

/// Delivery note (remito) — non-fiscal transport document (#230).
model Remito {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  prefijo        String?   @db.VarChar(4)
  numero         Int?
  /// remito_x | remito_ingreso
  tipo           String    @db.VarChar(20)
  /// borrador | emitido | entregado | anulado
  estado         String    @db.VarChar(20) @default("borrador")
  clienteId      Int?
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  proveedorId    Int?
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  facturaId      Int?
  factura        Factura?  @relation(fields: [facturaId], references: [id])
  pedidoId       Int?      @unique
  pedido         Pedido?   @relation(fields: [pedidoId], references: [id])
  ordenEntregaId Int?      @unique
  ordenEntrega   OrdenEntrega? @relation(fields: [ordenEntregaId], references: [id])
  fecha          DateTime  @default(now())
  fechaEntrega   DateTime?
  observaciones  String?   @db.VarChar(500)
  firmadoPor     String?   @db.VarChar(120)
  items          RemitoItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, prefijo, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, fecha])
}

model RemitoItem {
  id          Int      @id @default(autoincrement())
  remitoId    Int
  remito      Remito   @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  articuloId  Int
  articulo    Articulo @relation(fields: [articuloId], references: [id])
  descripcion String   @db.VarChar(120)
  cantidad    Int      @default(1)
  unidad      String   @db.VarChar(6)
  createdAt   DateTime @default(now())
}

/// Check portfolio — received/issued, physical/ECHEQ (#231).
model Cheque {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  /// recibido | emitido
  tipo             String    @db.VarChar(20)
  /// fisico | echeq
  modalidad        String    @db.VarChar(10)
  numero           String    @db.VarChar(30)
  banco            String    @db.VarChar(50)
  sucursal         String?   @db.VarChar(30)
  cbuOrigen        String?   @db.VarChar(22)
  libradorNombre   String    @db.VarChar(80)
  libradorCuit     String?   @db.VarChar(14)
  monto            Decimal   @db.Decimal(14, 2)
  moneda           String    @default("ARS") @db.VarChar(3)
  fechaEmision     DateTime
  fechaVencimiento DateTime
  /// en_cartera | emitido | depositado | endosado | descontado | cobrado | rechazado | anulado
  estado           String    @db.VarChar(20)
  clienteId        Int?
  cliente          Cliente?  @relation(fields: [clienteId], references: [id])
  proveedorId      Int?
  proveedor        Proveedor? @relation(fields: [proveedorId], references: [id])
  observaciones    String?   @db.VarChar(500)
  movimientos      ChequeMov[]
  cobros           Cobro[]
  recibosPago      ReciboPago[]
  reciboCobroFormas ReciboCobroForma[]
  movimientoCC     MovimientoClienteCC?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, banco, numero])
  @@index([tenantId, estado])
  @@index([tenantId, tipo])
  @@index([tenantId, fechaVencimiento])
}

model ChequeMov {
  id        Int      @id @default(autoincrement())
  chequeId  Int
  cheque    Cheque   @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  /// recepcion | deposito | endoso | descuento | cobro | rechazo
  tipo      String   @db.VarChar(20)
  fecha     DateTime @default(now())
  monto     Decimal? @db.Decimal(14, 2)
  destino   String?  @db.VarChar(120)
  nota      String?  @db.VarChar(500)
  userId    Int
  usuario   AppUser  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([chequeId])
}

model PedidoItem {
  id         Int     @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  /// Null for ad-hoc service lines (#244).
  articuloId Int?
  articulo   Articulo? @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  /// Line snapshot for PDF/reports (catalog or free-text service).
  descripcion String @default("") @db.VarChar(120)
  condIva     String @default("1") @db.VarChar(1)
  unidadServicio String? @db.VarChar(12)
  cantidad   Int     @default(1)
  precio     Decimal @db.Decimal(14, 2)
  dscto      Decimal @db.Decimal(5, 2) @default(0)
  subtotal   Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
}

model FacturaItem {
  id        Int     @id @default(autoincrement())
  facturaId Int
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  /// Null for ad-hoc service lines (#244).
  articuloId Int?
  articulo   Articulo? @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  /// Line snapshot for PDF/reports (catalog or free-text service).
  descripcion String @default("") @db.VarChar(120)
  condIva     String @default("1") @db.VarChar(1)
  unidadServicio String? @db.VarChar(12)

  cantidad  Int       @default(1)
  precio    Decimal   @db.Decimal(14, 2)
  dscto     Decimal   @db.Decimal(5, 2) @default(0)
  subtotal  Decimal   @db.Decimal(14, 2)

  createdAt DateTime  @default(now())

  garantias Garantia[]
}

model ParamEmpresa {
  id          Int     @id @default(autoincrement())
  tenantId    Int     @unique
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  nombre      String  @db.VarChar(40)
  cuit        String  @db.VarChar(14)
  domicilio   String? @db.VarChar(40)
  puntoVenta  Int     @default(1)
  tipoFactura String  @db.VarChar(1) @default("B")
  logoUrl     String? @db.VarChar(255)
  recordatorioDiasGracia Int @default(0)
  /// IANA timezone for collection reminders (e.g. America/Argentina/Buenos_Aires)
  timezone    String  @default("America/Argentina/Buenos_Aires") @db.VarChar(64)
  /// Business-hour window start (0–23, tenant local) for reminder job
  recordatorioHoraInicio Int @default(8)
  /// Business-hour window end exclusive (1–24, tenant local)
  recordatorioHoraFin    Int @default(18)
  /// Issuer VAT condition (RI, Mono, CF, Exento) — invoice PDF header (#148)
  condicionIva           String   @default("RI") @db.VarChar(10)
  /// Gross income registration (optional, PDF header)
  ingresosBrutos         String?  @db.VarChar(30)
  /// Activity start date (optional, PDF header)
  fechaInicioActividades DateTime? @db.Date
}

model TenantFiscalConfig {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
