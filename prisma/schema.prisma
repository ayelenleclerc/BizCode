  stockAjustes                     StockAjuste[]
  depositos                        Deposito[]
  stockDepositos                   StockDeposito[]
  transferenciasDeposito           TransferenciaDeposito[]
  recuentos                        Recuento[]
  tenantConfig                     TenantConfig?
  moduleTrials                     TenantModuleTrial[]
  tenantPlan                       TenantPlan?
  saasSubscription                 SaasSubscription?
  saasInvoices                     SaasInvoice[]
  fiscalRetencionesConfig          FiscalRetencionesConfig?
