  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                       AppSession[]
  refreshTokens                  AppRefreshToken[]
  mfaBackupCodes                 AppMfaBackupCode[]
  auditEvents                    AuditEvent[]
  notifications                  Notification[]
  devicePushTokens               DevicePushToken[]
  pushNotificationPreference     PushNotificationPreference?
  chatMessagesSent               ChatMessage[]               @relation("ChatMessageSender")
  chatMessagesReceived           ChatMessage[]               @relation("ChatMessageRecipient")
  ordenesEntregaDriver           OrdenEntrega[]              @relation("OrdenEntregaDriver")
  ordenesEntregaPicker           OrdenEntrega[]              @relation("OrdenEntregaPicker")
  repartosChofer                 Reparto[]                   @relation("RepartoChofer")
  devolucionesEntregaRegistered  DevolucionEntrega[]         @relation("DevolucionEntregaRegisteredBy")
  devolucionesEntregaRemitted    DevolucionEntrega[]         @relation("DevolucionEntregaRemittedBy")
  pedidosVendedor                Pedido[]
  plantillasPedido               PlantillaPedido[]
  visitasVendedor                VisitaVendedor[]
  vendedorZonas                  VendedorZona[]
  rutasVendedor                  RutaVendedor[]
  stockAjustes                   StockAjuste[]
  recuentosOperados              Recuento[]                  @relation("RecuentoOperador")
  depositosResponsable           Deposito[]                  @relation("DepositoResponsable")
  transferenciasSolicitadas      TransferenciaDeposito[]     @relation("TransferenciaSolicitadoPor")
  transferenciasAprobadas        TransferenciaDeposito[]     @relation("TransferenciaAprobadoPor")
  tenantConfigsUpdated           TenantConfig[]              @relation("TenantConfigUpdatedBy")
  tenantConfigHistory            TenantConfigHistory[]       @relation("TenantConfigHistoryChangedBy")
  tenantPlansChanged             TenantPlan[]                @relation("TenantPlanChangedBy")
  notasCreditoCreated            NotaCredito[]               @relation("NotaCreditoCreatedBy")
  movimientosProveedorCC         MovimientoProveedorCC[]
  movimientosClienteCC           MovimientoClienteCC[]
  recibosPago                    ReciboPago[]
  recibosCobro                   ReciboCobro[]
  documentosCompraImportados     DocumentoCompraImportado[]
  chequeMovimientos              ChequeMov[]
  presentacionesRetencion        PresentacionRetencion[]     @relation("PresentacionRetencionCreatedBy")
  mercadoPagoRefundsCreated      MercadoPagoRefund[]         @relation("MercadoPagoRefundCreatedBy")
  mercadoPagoChargebacksResolved MercadoPagoChargeback[]     @relation("MercadoPagoChargebackResolvedBy")
  ordenesTrabajoTecnico          OrdenTrabajo[]              @relation("OrdenTrabajoTecnico")
  garantiaUsos                   GarantiaUso[]               @relation("GarantiaUsoUser")
  turnosCajaCajero               TurnoCaja[]                 @relation("TurnoCajaCajero")
  movimientosCaja                MovimientoCaja[]            @relation("MovimientoCajaUser")
  configsComision                ConfigComision[]            @relation("ConfigComisionVendedor")
  liquidacionesComision          LiquidacionComision[]       @relation("LiquidacionComisionVendedor")
  liquidacionesComisionAprobadas LiquidacionComision[]       @relation("LiquidacionComisionAprobadoPor")
  importJobs                     ImportJob[]                 @relation("ImportJobCreatedBy")
  periodosBancariosLock          PeriodoBancarioLock[]
  tiposCambio                    TipoCambio[]                @relation("TipoCambioCreatedBy")
  ordenesProduccion              OrdenProduccion[]           @relation("OrdenProduccionOperador")
  movimientosPuntos              MovimientoPuntos[]          @relation("MovimientoPuntosUser")

