  periodStart    DateTime
  periodEnd      DateTime
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("ARS") @db.VarChar(8)
  /// pending | paid | failed
  status         String            @db.VarChar(20)
  mpPaymentId    String?           @unique @db.VarChar(80)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, createdAt])
  @@index([subscriptionId])
}

/// @en Idempotent platform SaaS billing webhook receipts (#182).
/// @es Recibos idempotentes de webhook de billing SaaS de plataforma (#182).
/// @pt-BR Recibos idempotentes de webhook de billing SaaS da plataforma (#182).
model SaasWebhookEvent {
  id             Int      @id @default(autoincrement())
  idempotencyKey String   @unique @db.VarChar(160)
  eventType      String   @db.VarChar(80)
  payload        Json
  processedAt    DateTime @default(now())
}

model TenantConfig {
  id                           Int      @id @default(autoincrement())
  tenantId                     Int      @unique
  tenant                       Tenant   @relation(fields: [tenantId], references: [id])
  businessType                 String   @default("ambos") @db.VarChar(20)
  rubros                       String[] @default([])
  plan                         String   @default("starter") @db.VarChar(20)
  modules                      String[]
  integrations                 String[] @default([])
  /// @en Default commission accrual mode for new configs (#237).
  /// @es Modo de devengo de comisión por defecto para configs nuevas (#237).
  /// @pt-BR Modo de apropriação de comissão padrão para novas configs (#237).
  /// porcentaje_cobrado | porcentaje_facturado | importe_fijo_por_venta
  comisionesModoDevengo        String   @default("porcentaje_cobrado") @db.VarChar(40)
  /// @en Preferred FX rate type for USD/EUR catalog prices (#243).
  /// @es Tipo de TC preferido para precios USD/EUR de catálogo (#243).
  /// @pt-BR Tipo de câmbio preferido para preços USD/EUR de catálogo (#243).
  /// oficial | mep | ccl | blue | manual
  tipoCambioPreferido          String   @default("oficial") @db.VarChar(20)
  /// @en Tax jurisdiction driving VAT rates, tax-id validation and country-specific modules (#207). ISO-3166-1 alpha-2; `AR` keeps the current behaviour.
  /// @es Jurisdiccion fiscal que gobierna alicuotas de IVA, validacion de identificador fiscal y modulos por pais (#207). ISO-3166-1 alpha-2; `AR` conserva el comportamiento actual.
  /// @pt-BR Jurisdicao fiscal que rege aliquotas de IVA, validacao de identificador fiscal e modulos por pais (#207). ISO-3166-1 alpha-2; `AR` mantem o comportamento atual.
  /// AR | UY
  jurisdiccionFiscal           String   @default("AR") @db.VarChar(2)
  /// @en Seller action when credit limit is exceeded (#256). warn | block
  /// @es Acción Seller al superar límite de crédito (#256). warn | block
  /// @pt-BR Ação Seller ao superar limite de crédito (#256). warn | block
  sellerCreditOverLimitAction  String   @default("block") @db.VarChar(10)
  /// @en Seller action when overdue debt exists (#256). warn | block
  /// @es Acción Seller con deuda vencida (#256). warn | block
  /// @pt-BR Ação Seller com dívida vencida (#256). warn | block
  sellerCreditOverdueAction    String   @default("warn") @db.VarChar(10)
  /// @en Seller action when line stock is zero (#256). warn | block
  /// @es Acción Seller con stock cero en línea (#256). warn | block
  /// @pt-BR Ação Seller com estoque zero na linha (#256). warn | block
  sellerStockZeroAction        String   @default("warn") @db.VarChar(10)
  /// @en Cap order qty to available stock in Seller app (#256).
  /// @es Limitar cantidad del pedido al stock disponible en Seller (#256).
  /// @pt-BR Limitar a quantidade do pedido ao estoque disponível no Seller (#256).
  sellerStockCapQtyToAvailable Boolean  @default(true)
  /// @en Optional Seller WhatsApp order-confirmation template (#265). Variables {{numero}} {{fecha}} {{items}} {{total}} {{empresa}}.
  /// @es Plantilla opcional WhatsApp de confirmación Seller (#265). Variables {{numero}} {{fecha}} {{items}} {{total}} {{empresa}}.
  /// @pt-BR Modelo opcional WhatsApp de confirmação Seller (#265). Variáveis {{numero}} {{fecha}} {{items}} {{total}} {{empresa}}.
  sellerWhatsappTemplate       String?  @db.VarChar(1024)
  updatedById                  Int?
  updatedBy                    AppUser? @relation("TenantConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt                    DateTime @updatedAt
  createdAt                    DateTime @default(now())

  @@index([tenantId])
}

model TenantModuleTrial {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  moduleKey String   @db.VarChar(80)
  expiresAt DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, moduleKey])
  @@index([tenantId, active, expiresAt])
}

model TenantConfigHistory {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  changedById Int
  changedBy   AppUser  @relation("TenantConfigHistoryChangedBy", fields: [changedById], references: [id])
  before      Json
  after       Json
  reason      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model OrdenEntrega {
  id                      Int           @id @default(autoincrement())
  tenantId                Int
  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
  facturaId               Int?
  factura                 Factura?      @relation(fields: [facturaId], references: [id])
  clienteId               Int
  cliente                 Cliente       @relation(fields: [clienteId], references: [id])
  zonaId                  Int?
  zona                    DeliveryZone? @relation(fields: [zonaId], references: [id])
  driverId                Int?
  driver                  AppUser?      @relation("OrdenEntregaDriver", fields: [driverId], references: [id])
  pickerUserId            Int?
  picker                  AppUser?      @relation("OrdenEntregaPicker", fields: [pickerUserId], references: [id])
  pickingIniciadoAt       DateTime?
  pickingListoAt          DateTime?
  /// Set when OE transitions to in_transit (physical dispatch); see ADR-0011 (#145).
  dispatchedAt            DateTime?
  /// event | estimated — estimated only from legacy backfill (#145).
  dispatchTimestampSource String?       @db.VarChar(20)
  /// @en Picking deposit when inventory.warehouses is enabled (#236).
  /// @es Depósito de picking cuando inventory.warehouses está activo (#236).
  /// @pt-BR Depósito de picking quando inventory.warehouses está ativo (#236).
  depositoId              Int?
  deposito                Deposito?     @relation(fields: [depositoId], references: [id], onDelete: SetNull)
  fecha                   DateTime
  /// pending | picking | ready | assigned | in_transit | delivered | failed | cancelled
  estado                  String        @default("pending") @db.VarChar(20)
  nota                    String?       @db.VarChar(200)
  /// @en Carrier for parcel shipping (#193). @es Transportista del envío postal (#193). @pt-BR Transportadora do envio (#193).
  /// correo_argentino | andreani | propio | meli_full
  transportista           String?       @db.VarChar(40)
  /// @en Carrier tracking number (#193). @es Número de seguimiento del transportista (#193). @pt-BR Número de rastreio (#193).
  nroSeguimiento          String?       @db.VarChar(80)
  /// @en Carrier shipment status (#193), independent of OE `estado`. @es Estado del envío en el carrier (#193). @pt-BR Status do envio no carrier (#193).
  /// pending | in_transit | delivered | returned
  estadoEnvio             String?       @db.VarChar(20)
  /// @en Last carrier event / cache timestamp (#193). @es Último evento / cache del carrier (#193). @pt-BR Último evento / cache do carrier (#193).
  ultimoEventoAt          DateTime?
  /// @en Cached tracking timeline JSON (#193). @es Timeline de tracking en caché (#193). @pt-BR Timeline de rastreio em cache (#193).
  trackingEventos         Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  repartoItems RepartoItem[]
  remito       Remito?

  @@index([tenantId, estado])
  @@index([tenantId, fecha])
  @@index([tenantId, driverId])
  @@index([tenantId, pickerUserId])
  @@index([tenantId, dispatchedAt])
  @@index([tenantId, depositoId])
  @@index([tenantId, estadoEnvio])
}

/// Per-tenant courier API credentials (#193); secrets encrypted at rest.
model ShippingCarrierConfig {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  /// andreani | correo_argentino
  carrier           String   @db.VarChar(40)
  usernameEncrypted String   @db.Text
  passwordEncrypted String   @db.Text
  usernameLast4     String   @db.VarChar(4)
  sandboxMode       Boolean  @default(true)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, carrier])
  @@index([tenantId, activo])
}

/// Delivery route grouping delivery orders (#140).
model Reparto {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  fecha         DateTime
  choferId      Int
  chofer        AppUser   @relation("RepartoChofer", fields: [choferId], references: [id])
  /// planned | on_route | completed | cancelled
  estado        String    @default("planned") @db.VarChar(20)
  vehiculo      String?   @db.VarChar(60)
  observaciones String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  items               RepartoItem[]
  ubicaciones         RepartoUbicacion[]
  devolucionesEntrega DevolucionEntrega[]

  @@index([tenantId, fecha])
  @@index([tenantId, estado])
  @@index([tenantId, choferId])
}

/// Driver GPS samples for active routes (#144).
model RepartoUbicacion {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  repartoId  Int
  reparto    Reparto  @relation(fields: [repartoId], references: [id], onDelete: Cascade)
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  recordedAt DateTime @default(now())

  @@index([repartoId, recordedAt])
  @@index([tenantId, recordedAt])
}

model RepartoItem {
  id                Int                @id @default(autoincrement())
  repartoId         Int
  reparto           Reparto            @relation(fields: [repartoId], references: [id], onDelete: Cascade)
  ordenEntregaId    Int
  ordenEntrega      OrdenEntrega       @relation(fields: [ordenEntregaId], references: [id])
  secuencia         Int
  /// pending | delivered | not_delivered | returned
  estado            String             @default("pending") @db.VarChar(20)
  entregadoAt       DateTime?
  /// ausente | rechazo | domicilio_incorrecto | producto_dañado | otro
  motivoNoEntrega   String?            @db.VarChar(30)
  receptorNombre    String?            @db.VarChar(120)
  receptorDni       String?            @db.VarChar(20)
  notasEntrega      String?            @db.VarChar(500)
  /// { firmaBase64?, fotoBase64? } — MVP POD media (#142)
  podMedia          Json?
  devolucionEntrega DevolucionEntrega?

  @@index([repartoId])
  @@index([ordenEntregaId])
}

/// @en Delivery-stop return registered by the driver; stock/NC only on remittance (#163).
/// @es Devolución de parada registrada por el chofer; stock/NC solo en rendición (#163).
/// @pt-BR Devolução da parada registrada pelo motorista; estoque/NC só na prestação (#163).
model DevolucionEntrega {
  id             Int                      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  repartoId      Int
  reparto        Reparto                  @relation(fields: [repartoId], references: [id], onDelete: Cascade)
  repartoItemId  Int                      @unique
  repartoItem    RepartoItem              @relation(fields: [repartoItemId], references: [id], onDelete: Cascade)
  /// rechazo | producto_dañado
  motivo         String                   @db.VarChar(30)
  motivoDetalle  String?                  @db.VarChar(500)
  fotoBase64     String?                  @db.Text
  /// registered | remitted
  estado         String                   @default("registered") @db.VarChar(20)
  registeredById Int
  registeredBy   AppUser                  @relation("DevolucionEntregaRegisteredBy", fields: [registeredById], references: [id])
  remittedAt     DateTime?
  remittedById   Int?
  remittedBy     AppUser?                 @relation("DevolucionEntregaRemittedBy", fields: [remittedById], references: [id])
  notaCreditoId  Int?
  notaCredito    NotaCredito?             @relation(fields: [notaCreditoId], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  lineas         DevolucionEntregaLinea[]

  @@index([tenantId, repartoId, estado])
  @@index([tenantId, registeredById])
}

model DevolucionEntregaLinea {
  id                  Int               @id @default(autoincrement())
  devolucionEntregaId Int
  devolucionEntrega   DevolucionEntrega @relation(fields: [devolucionEntregaId], references: [id], onDelete: Cascade)
  articuloId          Int
  articulo            Articulo          @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  facturaItemId       Int?
  facturaItem         FacturaItem?      @relation(fields: [facturaItemId], references: [id], onDelete: SetNull)
  cantidad            Decimal           @db.Decimal(14, 4)

  @@index([devolucionEntregaId])
  @@index([articuloId])
}

model AppUser {
  id                  Int       @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  username            String    @db.VarChar(60)
  passwordHash        String    @db.VarChar(255)
  role                UserRole
  active              Boolean   @default(true)
  scopeBranchIds      Int[]     @default([])
  scopeWarehouseIds   Int[]     @default([])
  scopeRouteIds       Int[]     @default([])
  scopeChannels       String[]  @default([])
