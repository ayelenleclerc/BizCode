  factura          Factura?  @relation(fields: [facturaId], references: [id])
  /// pendiente | resuelto | ignorado
  estado           String    @db.VarChar(20)
  payload          Json
  notifiedAt       DateTime?
  resolvedByUserId Int?
  resolvedBy       AppUser?  @relation("MercadoPagoChargebackResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, mpChargebackId])
  @@index([tenantId, estado])
}

/// MercadoPago credentials per tenant (#174); access token and webhook secret encrypted at rest.
model MercadoPagoConfig {
