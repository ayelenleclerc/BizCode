{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ajuste": {
      "nullable": true,
      "properties": {
        "frecuenciaAjuste": {
          "$ref": "./ContratoFrecuencia.schema.json"
        },
        "porcentaje": {
          "nullable": true,
          "type": "number"
        },
        "proximoAjuste": {
          "type": "string"
        },
        "tipo": {
          "enum": [
            "porcentaje_fijo",
            "manual"
          ],
          "type": "string"
        }
      },
      "required": [
        "tipo",
        "frecuenciaAjuste",
        "proximoAjuste"
      ],
      "type": "object"
    },
    "clienteId": {
      "minimum": 1,
      "type": "integer"
    },
    "descripcion": {
      "maxLength": 500,
      "nullable": true,
      "type": "string"
    },
    "diaDelMes": {
      "maximum": 31,
      "minimum": 1,
      "type": "integer"
    },
    "fechaFin": {
      "nullable": true,
      "type": "string"
    },
    "fechaInicio": {
      "type": "string"
    },
    "frecuencia": {
      "$ref": "./ContratoFrecuencia.schema.json"
    },
    "incluyeIVA": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "properties": {
          "articuloId": {
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "cantidad": {
            "minimum": 1,
            "type": "integer"
          },
          "condIva": {
            "enum": [
              "1",
              "2",
              "3"
            ],
            "type": "string"
          },
          "descripcion": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "dscto": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "precioUnit": {
            "minimum": 0,
            "type": "number"
          },
          "unidadServicio": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "descripcion",
          "cantidad",
          "precioUnit"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "ivaAlicuota": {
      "type": "number"
    },
    "modoEmision": {
      "enum": [
        "auto",
        "revision"
      ],
      "type": "string"
    },
    "moneda": {
      "default": "ARS",
      "type": "string"
    },
    "nombre": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "prefijo": {
      "type": "string"
    },
    "proximaFact": {
      "type": "string"
    },
    "tipoFactura": {
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    }
  },
  "required": [
    "clienteId",
    "nombre",
    "frecuencia",
    "diaDelMes",
    "fechaInicio",
    "items"
  ],
  "title": "ContratoInput",
  "type": "object"
}
