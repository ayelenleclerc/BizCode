{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "clienteId": {
      "type": "integer"
    },
    "confirmAnomalies": {
      "description": "When true, acknowledges soft-blocked duplicate anomaly and proceeds with create (#200). Required to create after HTTP 422 DUPLICATE_INVOICE_CONFIRM_REQUIRED.\n",
      "type": "boolean"
    },
    "fecha": {
      "format": "date",
      "type": "string"
    },
    "formaPagoId": {
      "nullable": true,
      "type": "integer"
    },
    "incoterm": {
      "allOf": [
        {
          "$ref": "./Incoterm.schema.json"
        }
      ],
      "nullable": true
    },
    "items": {
      "items": {
        "description": "Catalog line requires articuloId. Ad-hoc service line omits articuloId and requires\ndescripcion + condIva (#244).\n",
        "properties": {
          "articuloId": {
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "cantidad": {
            "type": "number"
          },
          "condIva": {
            "enum": [
              "1",
              "2",
              "3"
            ],
            "type": "string"
          },
          "descripcion": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "dscto": {
            "type": "number"
          },
          "precio": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "unidadServicio": {
            "enum": [
              "hora",
              "dia",
              "mes",
              "proyecto",
              "km",
              "unidad",
              "otro"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "cantidad",
          "precio",
          "dscto",
          "subtotal"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "iva1": {
      "type": "number"
    },
    "iva2": {
      "type": "number"
    },
    "monedaOperacion": {
      "description": "Export vertical (#206, module `vertical.export`). Currency the operation is denominated in. A non-local currency requires `totalMonedaOperacion` and `tipoCambioOperacion`; otherwise the request fails with 422. `total` stays in local currency and the AFIP circuit is untouched (no type E voucher, no `MonId`/`MonCotiz`).",
      "enum": [
        "ARS",
        "USD",
        "EUR"
      ],
      "nullable": true,
      "type": "string"
    },
    "neto1": {
      "type": "number"
    },
    "neto2": {
      "type": "number"
    },
    "neto3": {
      "type": "number"
    },
    "numero": {
      "type": "integer"
    },
    "paisDestino": {
      "description": "ISO-3166-1 alpha-2 destination country (#206).",
      "maxLength": 2,
      "minLength": 2,
      "nullable": true,
      "type": "string"
    },
    "percepciones": {
      "items": {
        "$ref": "./ReciboPagoRetencionInput.schema.json"
      },
      "type": "array"
    },
    "prefijo": {
      "type": "string"
    },
    "puntosCanje": {
      "description": "Optional loyalty points to redeem as a negative invoice line (#250).",
      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "recetaId": {
      "description": "Prescription backing the dispensing of prescription-only articles (#204). With module `vertical.pharmacy` enabled, invoicing an article flagged `requiereReceta` without this field fails with HTTP 422 `PRESCRIPTION_REQUIRED:<articuloIds>`.\n",
      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "tipo": {
      "enum": [
        "A",
        "B"
      ],
      "type": "string"
    },
    "tipoCambioOperacion": {
      "description": "Exchange rate applied to the operation; persisted in the invoice FX snapshot.",
      "exclusiveMinimum": 0,
      "nullable": true,
      "type": "number"
    },
    "total": {
      "description": "Must equal netos + IVA + sum(percepciones) when percepciones are sent (#229).",
      "type": "number"
    },
    "totalMonedaOperacion": {
      "exclusiveMinimum": 0,
      "nullable": true,
      "type": "number"
    }
  },
  "required": [
    "fecha",
    "tipo",
    "numero",
    "clienteId",
    "neto1",
    "neto2",
    "neto3",
    "iva1",
    "iva2",
    "total",
    "items"
  ],
  "title": "FacturaInput",
  "type": "object"
}
