{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "entregadoAt": {
      "format": "date-time",
      "nullable": true,
      "type": "string"
    },
    "estado": {
      "enum": [
        "pending",
        "delivered",
        "not_delivered",
        "returned"
      ],
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "motivoNoEntrega": {
      "nullable": true,
      "type": "string"
    },
    "ordenEntrega": {
      "$ref": "./OrdenEntrega.schema.json"
    },
    "ordenEntregaId": {
      "type": "integer"
    },
    "secuencia": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "ordenEntregaId",
    "secuencia",
    "estado",
    "ordenEntrega"
  ],
  "title": "RepartoItemLine",
  "type": "object"
}
