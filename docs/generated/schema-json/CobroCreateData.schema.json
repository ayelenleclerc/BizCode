{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cobro": {
      "$ref": "./Cobro.schema.json"
    },
    "montoBruto": {
      "description": "Bruto applied to customer balance (neto + retenciones).",
      "type": "string"
    },
    "retenciones": {
      "items": {
        "$ref": "./CobroRetencion.schema.json"
      },
      "type": "array"
    },
    "updatedCliente": {
      "additionalProperties": true,
      "properties": {
        "balance": {
          "type": "number"
        },
        "creditLimit": {
          "nullable": true,
          "type": "number"
        },
        "id": {
          "type": "integer"
        },
        "rsocial": {
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "score"
      ],
      "type": "object"
    }
  },
  "required": [
    "cobro",
    "updatedCliente",
    "retenciones",
    "montoBruto"
  ],
  "title": "CobroCreateData",
  "type": "object"
}
