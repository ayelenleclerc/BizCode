    "okCount": {
      "type": "integer"
    },
    "processedRows": {
      "type": "integer"
    },
    "skippedCount": {
      "type": "integer"
    },
    "tenantId": {
      "type": "integer"
    },
    "totalRows": {
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "updatedCount": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "tenantId",
    "entity",
    "estado",
    "modo",
    "duplicateMode",
    "totalRows",
    "processedRows",
    "okCount",
    "errorCount",
    "duplicateCount",
    "createdCount",
    "updatedCount",
    "skippedCount",
    "createdById",
    "createdAt",
    "updatedAt",
    "completedAt"
