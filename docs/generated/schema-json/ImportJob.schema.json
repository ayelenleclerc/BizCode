{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completedAt": {
      "format": "date-time",
      "nullable": true,
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "createdById": {
      "type": "integer"
    },
    "createdCount": {
      "type": "integer"
    },
    "duplicateCount": {
      "type": "integer"
    },
    "duplicateMode": {
      "enum": [
        "update",
        "skip"
      ],
      "type": "string"
    },
    "entity": {
