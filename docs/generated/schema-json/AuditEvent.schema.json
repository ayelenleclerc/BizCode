{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "ipAddress": {
      "nullable": true,
      "type": "string"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional structured details for the event"
    },
    "resource": {
      "type": "string"
    },
    "resourceId": {
      "nullable": true,
      "type": "string"
    },
    "tenantId": {
      "type": "integer"
    },
    "userId": {
      "nullable": true,
      "type": "integer"
    },
    "username": {
      "description": "Username of the actor when resolved; otherwise null",
      "nullable": true,
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenantId",
    "action",
    "resource",
    "createdAt"
  ],
  "title": "AuditEvent",
  "type": "object"
}
