{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activo": {
      "type": "boolean"
    },
    "codigo": {
      "type": "integer"
    },
    "condIva": {
      "type": "string"
    },
    "costo": {
      "type": "number"
    },
    "descripcion": {
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "mesesGarantia": {
      "description": "Warranty months for physical articles; null = no warranty (#251).",
      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "minimo": {
      "type": "integer"
    },
    "precioLista1": {
      "type": "number"
    },
    "precioLista2": {
      "type": "number"
    },
    "rubro": {
      "$ref": "./Rubro.schema.json"
    },
    "rubroId": {
      "type": "integer"
    },
    "stock": {
      "type": "integer"
    },
    "tipo": {
      "description": "Catalog item kind (#244). Default articulo.",
      "enum": [
        "articulo",
        "servicio"
      ],
      "type": "string"
    },
    "umedida": {
      "type": "string"
    },
    "unidadServicio": {
      "description": "Required when tipo is servicio (#244).",
      "enum": [
        "hora",
        "dia",
        "mes",
        "proyecto",
        "km",
        "unidad",
        "otro"
      ],
      "nullable": true,
      "type": "string"
    }
  },
  "title": "Articulo",
  "type": "object"
}
