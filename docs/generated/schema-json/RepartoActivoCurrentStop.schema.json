{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cliente": {
      "properties": {
        "codigo": {
          "type": "integer"
        },
        "domicilio": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "rsocial": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "codigo",
        "rsocial"
      ],
      "type": "object"
    },
    "secuencia": {
      "minimum": 1,
      "type": "integer"
    },
    "zona": {
      "nullable": true,
      "properties": {
        "id": {
          "type": "integer"
        },
        "nombre": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "secuencia",
    "cliente"
  ],
  "title": "RepartoActivoCurrentStop",
  "type": "object"
}
