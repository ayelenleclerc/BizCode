    },
    "cantidad": {
      "minimum": 1,
      "type": "integer"
    },
    "condIva": {
      "enum": [
        "1",
        "2",
        "3"
      ],
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "dscto": {
      "type": "number"
    },
