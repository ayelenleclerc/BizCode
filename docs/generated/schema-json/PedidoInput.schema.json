{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "clienteId": {
      "minimum": 1,
      "type": "integer"
    },
    "condicionCobro": {
      "description": "Intended collection terms (#169).",
      "enum": [
        "contado",
        "cuenta_corriente",
        "plazo",
        null
      ],
      "nullable": true,
      "type": "string"
    },
    "despachanteEmail": {
      "format": "email",
      "maxLength": 160,
      "nullable": true,
      "type": "string"
    },
    "despachanteNombre": {
      "description": "Customs broker name; requires `despachanteEmail` (#206).",
      "maxLength": 120,
      "nullable": true,
      "type": "string"
    },
    "incoterm": {
      "allOf": [
        {
          "$ref": "./Incoterm.schema.json"
        }
      ],
      "nullable": true
    },
    "items": {
      "items": {
        "description": "Catalog line requires articuloId. Ad-hoc service line omits articuloId and requires\ndescripcion + condIva (#244).\n",
        "properties": {
          "articuloId": {
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "cantidad": {
            "minimum": 1,
            "type": "integer"
          },
          "condIva": {
            "enum": [
              "1",
              "2",
              "3"
            ],
            "type": "string"
          },
          "descripcion": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "dscto": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "precio": {
            "minimum": 0,
            "type": "number"
          },
          "unidadServicio": {
            "enum": [
              "hora",
              "dia",
              "mes",
              "proyecto",
              "km",
              "unidad",
              "otro"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "cantidad",
          "precio"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "observaciones": {
      "description": "Warehouse notes (#169).",
      "maxLength": 500,
      "nullable": true,
      "type": "string"
    },
    "paisDestino": {
      "description": "ISO-3166-1 alpha-2 destination country (#206).",
      "maxLength": 2,
      "minLength": 2,
      "nullable": true,
      "type": "string"
    },
    "plazoDias": {
      "description": "Required when condicionCobro is plazo (#169).",
      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "validUntil": {
      "nullable": true,
      "type": "string"
    },
    "vendedorId": {
      "nullable": true,
      "type": "integer"
    }
  },
  "required": [
    "clienteId",
    "items"
  ],
  "title": "PedidoInput",
  "type": "object"
}
