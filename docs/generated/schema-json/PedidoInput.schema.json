{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "clienteId": {
      "minimum": 1,
      "type": "integer"
    },
    "items": {
      "items": {
        "description": "Catalog line requires articuloId. Ad-hoc service line omits articuloId and requires\ndescripcion + condIva (#244).\n",
        "properties": {
          "articuloId": {
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "cantidad": {
            "minimum": 1,
            "type": "integer"
          },
          "condIva": {
            "enum": [
              "1",
              "2",
              "3"
            ],
            "type": "string"
          },
          "descripcion": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "dscto": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "precio": {
            "minimum": 0,
            "type": "number"
          },
          "unidadServicio": {
            "enum": [
              "hora",
              "dia",
              "mes",
              "proyecto",
              "km",
              "unidad",
              "otro"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "cantidad",
          "precio"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "validUntil": {
      "nullable": true,
      "type": "string"
    },
    "vendedorId": {
      "nullable": true,
      "type": "integer"
    }
  },
  "required": [
    "clienteId",
    "items"
  ],
  "title": "PedidoInput",
  "type": "object"
}
