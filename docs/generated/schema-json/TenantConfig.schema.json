{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "businessType": {
      "enum": [
        "mayorista",
        "minorista",
        "ambos"
      ],
      "type": "string"
    },
    "integrations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "modules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan": {
      "enum": [
        "starter",
        "pro",
        "enterprise"
      ],
      "type": "string"
    },
    "rubros": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tenantId": {
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "tenantId",
    "businessType",
    "rubros",
    "plan",
    "modules",
    "integrations",
    "updatedAt"
  ],
  "title": "TenantConfig",
  "type": "object"
}
