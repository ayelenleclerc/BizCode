    "aprobadoPorId": {
      "nullable": true,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "destinoCodigo": {
      "type": "string"
    },
    "destinoId": {
      "type": "integer"
    },
    "estado": {
      "enum": [
        "pendiente",
        "en_transito",
        "recibida",
        "anulada"
      ],
      "type": "string"
    },
    "fechaEnvio": {
      "format": "date-time",
      "nullable": true,
      "type": "string"
    },
    "fechaRecepcion": {
      "format": "date-time",
      "nullable": true,
      "type": "string"
    },
    "id": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "./TransferenciaDepositoItem.schema.json"
      },
