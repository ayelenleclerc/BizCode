    },
    "nota": {
      "nullable": true,
      "type": "string"
    },
    "numero": {
      "type": "integer"
    },
    "origenCodigo": {
      "type": "string"
    },
    "origenId": {
      "type": "integer"
    },
    "solicitadoPorId": {
      "type": "integer"
    },
    "tenantId": {
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenantId",
    "numero",
    "origenId",
    "destinoId",
    "estado",
    "solicitadoPorId",
    "aprobadoPorId",
    "fechaEnvio",
    "fechaRecepcion",
    "nota",
    "createdAt",
    "updatedAt"
  ],
