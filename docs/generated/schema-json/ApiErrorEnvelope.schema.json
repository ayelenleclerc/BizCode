{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "type": "string"
    },
    "success": {
      "const": false,
      "type": "boolean"
    },
    "warnings": {
      "description": "Optional structured warnings (e.g. billing anomalies",
      "items": {
        "$ref": "./FacturaAnomalyWarning.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "success",
    "error"
  ],
  "title": "ApiErrorEnvelope",
  "type": "object"
}
