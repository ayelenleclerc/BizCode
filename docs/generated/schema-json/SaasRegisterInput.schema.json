{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acceptPrivacy": {
      "const": true,
      "type": "boolean"
    },
    "acceptTerms": {
      "const": true,
      "type": "boolean"
    },
    "businessName": {
      "maxLength": 80,
      "minLength": 2,
      "type": "string"
    },
    "cuit": {
      "maxLength": 14,
      "minLength": 11,
      "type": "string"
    },
    "email": {
      "format": "email",
      "maxLength": 120,
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "phone": {
      "maxLength": 40,
      "type": "string"
    },
    "tenantSlug": {
      "maxLength": 80,
      "minLength": 2,
      "type": "string"
    }
  },
  "required": [
    "businessName",
    "cuit",
    "email",
    "tenantSlug",
    "password",
    "acceptTerms",
    "acceptPrivacy"
  ],
  "title": "SaasRegisterInput",
  "type": "object"
}
