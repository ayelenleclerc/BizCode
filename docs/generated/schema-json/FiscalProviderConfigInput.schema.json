{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ambiente": {
      "enum": [
        "homologacion",
        "produccion"
      ],
      "type": "string"
    },
    "certificate": {
      "type": "string"
    },
    "cnpj": {
      "description": "Tax ID CNPJ for brazil_sefaz_nfe (#211) mock config",
      "maxLength": 18,
      "minLength": 14,
      "type": "string"
    },
    "cuit": {
      "type": "string"
    },
    "legalName": {
      "maxLength": 160,
      "type": "string"
    },
    "privateKey": {
      "type": "string"
    },
    "provider": {
      "$ref": "./FiscalProviderCode.schema.json"
    },
    "rfc": {
      "maxLength": 13,
      "minLength": 12,
      "type": "string"
    },
    "rut": {
      "description": "Tax ID RUT for uruguay_dgi (#207) or chile_sii (#208) mock config; algorithm depends on provider",
      "maxLength": 20,
      "minLength": 8,
      "type": "string"
    }
  },
  "required": [
    "provider"
  ],
  "title": "FiscalProviderConfigInput",
  "type": "object"
}
