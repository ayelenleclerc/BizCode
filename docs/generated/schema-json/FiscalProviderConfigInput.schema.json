{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ambiente": {
      "enum": [
        "homologacion",
        "produccion"
      ],
      "type": "string"
    },
    "certificate": {
      "type": "string"
    },
    "cuit": {
      "type": "string"
    },
    "legalName": {
      "maxLength": 160,
      "type": "string"
    },
    "privateKey": {
      "type": "string"
    },
    "provider": {
      "$ref": "./FiscalProviderCode.schema.json"
    },
    "rfc": {
      "maxLength": 13,
      "minLength": 12,
      "type": "string"
    },
    "rut": {
      "description": "Uruguayan RUT for uruguay_dgi mock config (#207)",
      "maxLength": 20,
      "minLength": 12,
      "type": "string"
    }
  },
  "required": [
    "provider"
  ],
  "title": "FiscalProviderConfigInput",
  "type": "object"
}
