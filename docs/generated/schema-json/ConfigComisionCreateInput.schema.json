      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "tipo": {
      "$ref": "./ComisionTipo.schema.json"
    },
    "vendedorId": {
      "minimum": 1,
      "type": "integer"
    },
    "vigenciaDesde": {
