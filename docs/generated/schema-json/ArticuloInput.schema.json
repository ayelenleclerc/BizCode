{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "activo": {
      "type": "boolean"
    },
    "codigo": {
      "minimum": 1,
      "type": "integer"
    },
    "condIva": {
      "enum": [
        "1",
        "2",
        "3"
      ],
      "type": "string"
    },
    "costo": {
      "minimum": 0.01,
      "type": "number"
    },
    "descripcion": {
      "maxLength": 30,
      "minLength": 3,
      "type": "string"
    },
    "mesesGarantia": {
      "description": "Warranty months; ignored for servicio (#251).",
      "minimum": 1,
      "nullable": true,
      "type": "integer"
    },
    "minimo": {
      "description": "Must be 0 when tipo is servicio (#244).",
      "minimum": 0,
      "type": "integer"
    },
    "monedaPrecio": {
      "default": "ARS",
      "description": "Catalog price currency; ARS materializes precioLista1 directly (#243).",
      "enum": [
        "ARS",
        "USD",
        "EUR"
      ],
      "type": "string"
    },
    "precioEnMonedaOrigen": {
      "description": "Required when monedaPrecio is USD or EUR; drives ARS precioLista1 via current TC (#243).",
      "minimum": 0.0001,
      "nullable": true,
      "type": "number"
    },
    "precioLista1": {
      "minimum": 0.01,
      "type": "number"
    },
    "precioLista2": {
      "minimum": 0.01,
      "type": "number"
    },
    "rubroId": {
      "type": "integer"
    },
    "stock": {
      "description": "Must be 0 when tipo is servicio (#244).",
      "minimum": 0,
      "type": "integer"
    },
    "tipo": {
      "default": "articulo",
      "enum": [
        "articulo",
        "servicio"
      ],
      "type": "string"
    },
    "umedida": {
      "maxLength": 6,
      "minLength": 2,
      "type": "string"
    },
    "unidadServicio": {
      "enum": [
        "hora",
        "dia",
        "mes",
        "proyecto",
        "km",
        "unidad",
        "otro"
      ],
      "nullable": true,
      "type": "string"
    }
  },
  "required": [
    "codigo",
    "descripcion",
    "rubroId",
    "condIva",
    "umedida",
    "precioLista1",
    "precioLista2",
    "costo",
    "stock",
    "minimo",
    "activo"
  ],
  "title": "ArticuloInput",
  "type": "object"
}
