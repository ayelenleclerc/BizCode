{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "consumerKey": {
      "maxLength": 200,
      "type": "string"
    },
    "consumerSecret": {
      "maxLength": 200,
      "type": "string"
    },
    "storeName": {
      "nullable": true,
      "type": "string"
    },
    "storeUrl": {
      "format": "uri",
      "maxLength": 255,
      "type": "string"
    },
    "webhookSecret": {
      "nullable": true,
      "type": "string"
    }
  },
  "required": [
    "storeUrl",
    "consumerKey",
    "consumerSecret"
  ],
  "title": "WooCommerceCredentialsInput",
  "type": "object"
}
