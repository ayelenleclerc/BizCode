{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "despachanteEmail": {
          "format": "email",
          "type": "string"
        },
        "enviado": {
          "description": "False when SMTP is not configured; the attempt is audited anyway.",
          "type": "boolean"
        },
        "pedidoId": {
          "type": "integer"
        }
      },
      "required": [
        "pedidoId",
        "despachanteEmail",
        "enviado"
      ],
      "type": "object"
    },
    "success": {
      "const": true,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "data"
  ],
  "title": "DespachanteNotificacionEnvelope",
  "type": "object"
}
