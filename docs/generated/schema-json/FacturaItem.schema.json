{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "articulo": {
      "$ref": "./Articulo.schema.json"
    },
    "articuloId": {
      "description": "Null for ad-hoc service lines (#244).",
      "nullable": true,
      "type": "integer"
    },
    "cantidad": {
      "description": "Quantity in article base units; may be decimal for cut-to-size UoM (#203).",
      "type": "number"
    },
    "codigoAfipUnidad": {
      "description": "AFIP WSFE UniMedida code snapshot (#203). Mock CAE has no line XML yet.",
      "maxLength": 2,
      "nullable": true,
      "type": "string"
    },
    "condIva": {
      "enum": [
        "1",
        "2",
        "3"
      ],
      "type": "string"
    },
    "descripcion": {
      "description": "Line snapshot (catalog or free-text) (#244).",
      "maxLength": 120,
      "type": "string"
    },
    "dscto": {
      "type": "number"
    },
    "id": {
      "type": "integer"
    },
    "precio": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "unidadMedida": {
      "description": "Base UoM snapshot at invoice time (#203).",
      "nullable": true,
      "type": "string"
    },
    "unidadServicio": {
      "enum": [
        "hora",
        "dia",
        "mes",
        "proyecto",
        "km",
        "unidad",
        "otro"
      ],
      "nullable": true,
      "type": "string"
    }
  },
  "title": "FacturaItem",
  "type": "object"
}
