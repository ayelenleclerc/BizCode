{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "none",
        "link",
        "qr"
      ],
      "type": "string"
    },
    "estado": {
      "$ref": "./MercadoPagoFacturaEstado.schema.json"
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "facturaRef": {
      "type": "string"
    },
    "pagadoAt": {
      "format": "date-time",
      "type": "string"
    },
    "paymentLink": {
      "format": "uri",
      "type": "string"
    },
    "preferenceId": {
      "type": "string"
    },
    "qrData": {
      "type": "string"
    },
    "qrExpiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "qrImageBase64": {
      "type": "string"
    },
    "qrOrderId": {
      "type": "string"
    }
  },
  "required": [
    "estado"
  ],
  "title": "MercadoPagoFacturaPayment",
  "type": "object"
}
