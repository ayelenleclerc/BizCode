{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cuit": {
      "maxLength": 14,
      "type": "string"
    },
    "domicilio": {
      "maxLength": 40,
      "nullable": true,
      "type": "string"
    },
    "logoUrl": {
      "maxLength": 255,
      "nullable": true,
      "type": "string"
    },
    "nombre": {
      "maxLength": 40,
      "type": "string"
    },
    "puntoVenta": {
      "maximum": 9999,
      "minimum": 1,
      "type": "integer"
    },
    "tipoFactura": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "cuit",
    "puntoVenta",
    "tipoFactura"
  ],
  "title": "EmpresaInput",
  "type": "object"
}
