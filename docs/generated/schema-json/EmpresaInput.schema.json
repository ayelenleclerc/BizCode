{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "condicionIva": {
      "enum": [
        "RI",
        "Mono",
        "CF",
        "Exento"
      ],
      "type": "string"
    },
    "cuit": {
      "maxLength": 14,
      "type": "string"
    },
    "domicilio": {
      "maxLength": 40,
      "nullable": true,
      "type": "string"
    },
    "esMipyme": {
      "description": "MiPyME flag for local FCEM detection (#239).",
      "type": "boolean"
    },
    "fcemUmbralMonto": {
      "description": "Optional FCEM amount threshold (ARS); null uses app default (#239).",
      "minimum": 0,
      "nullable": true,
      "type": "number"
    },
    "fechaInicioActividades": {
      "format": "date",
      "nullable": true,
      "type": "string"
    },
    "ingresosBrutos": {
      "maxLength": 30,
      "nullable": true,
      "type": "string"
    },
    "logoUrl": {
      "maxLength": 255,
      "nullable": true,
      "type": "string"
    },
    "nombre": {
      "maxLength": 40,
      "type": "string"
    },
    "puntoVenta": {
      "maximum": 9999,
      "minimum": 1,
      "type": "integer"
    },
    "recordatorioDiasGracia": {
      "maximum": 365,
      "minimum": 0,
      "type": "integer"
    },
    "recordatorioHoraFin": {
      "maximum": 24,
      "minimum": 1,
      "type": "integer"
    },
    "recordatorioHoraInicio": {
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
    },
    "timezone": {
      "maxLength": 64,
      "type": "string"
    },
    "tipoFactura": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "cuit",
    "puntoVenta",
    "tipoFactura"
  ],
  "title": "EmpresaInput",
  "type": "object"
}
