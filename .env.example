# Local dev and `npm run test:integration` (apply migrations: `npx prisma migrate deploy`)
#
# Prisma expects a full PostgreSQL URL. This line has no credentials (loopback URL only).
# If your Postgres requires a user/password, set the full URL in your real `.env` (gitignored) — never commit it.
DATABASE_URL=postgresql://127.0.0.1:5432/bizcode_dev?schema=public

# Required for `npm run server` (non-empty secret; local machine only).
JWT_SECRET=

# Optional Redis for refresh-token blacklist (#212). Local: docker compose -f docker-compose.redis.yml up -d
# REDIS_URL=redis://127.0.0.1:6379


# Required for API bootstrap (`development` | `test` | `production`).
NODE_ENV=development

# Required for `npx prisma db seed`: strong secret, local machine only (minimum 8 characters; see `prisma/seed.ts`).
BIZCODE_SEED_SUPERADMIN_PASSWORD=

# Optional: outbound email via SMTP_URL (smtp:/smtps:) or legacy SMTP_* variables (see server/channels.ts).
# SMTP_URL=smtp://user:pass@mail.example:587
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# TWILIO_ACCOUNT_SID=
# LOG_LEVEL=info
# METRICS_ENABLED=true
# Optional POS hardware (default off; PDF/CAE always available):
# FISCAL_PRINTER_ENABLED=false
# THERMAL_PRINTER_ENABLED=false
# CORS_ORIGINS=https://app.example
# HTTP_RATE_LIMIT_PER_MINUTE=100
# HTTP_RATE_LIMIT_AUTH_PER_MINUTE=20
# HTTP_RATE_LIMIT_IMPORT_PER_HOUR=5

# Optional: after SuperAdmin seed, upsert a minimal rubro (codigo=1) for local/demo parity (see docs/en/quality/test-environments-parity.md).
# BIZCODE_SEED_FIXTURE_CATALOG=true

# Optional: `npm run bootstrap:superadmin` — alternative to seed; does not update password if the user already exists (see README).
# BIZCODE_BOOTSTRAP_SUPERADMIN_PASSWORD=
# BIZCODE_BOOTSTRAP_SUPERADMIN_USERNAME=Ayelen

# Optional: legacy DBF tree for `npm run migrate:dbf` / `npx tsx scripts/inspect-dbf.ts` when Programa_Viejo is not under the repo root (absolute or relative to cwd).
# PROGRAMA_VIEJO_ROOT=D:/ruta/Programa_Viejo

# Optional: target Tenant.id for `npm run migrate:dbf` (defaults to the lowest Tenant.id when unset; requires at least one Tenant row, e.g. from `npx prisma db seed`).
# BIZCODE_MIGRATION_TENANT_ID=1

# ------------------------------------------------------------------------------
# Container deploy reference (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
# Keep real values in deployment secrets / host-level .env files only.
# POSTGRES_DB=bizcode
# POSTGRES_USER=bizcode
# POSTGRES_PASSWORD=
# APP_ENV=production
# FRONTEND_PORT=8080
# VITE_API_URL=/api
# CORS_ORIGINS=https://app.example
# SESSION_SECRET=
# BIZCODE_FISCAL_ENCRYPTION_KEY=
#
# Optional SSH deploy workflow (`.github/workflows/deploy.yml`) expects these
# repository secrets when auto-deploy is desired:
# - DEPLOY_HOST
# - DEPLOY_USER
# - DEPLOY_SSH_KEY
# - DEPLOY_PATH
# SSH port: workflow input `deploy_ssh_port` (default 22), not a repository secret
# - DATABASE_URL
# - POSTGRES_USER
# - POSTGRES_PASSWORD
# - POSTGRES_DB
# - APP_ENV
# - VITE_API_URL
# - CORS_ORIGINS
# - SESSION_SECRET
# - GHCR_TOKEN (optional when `GITHUB_TOKEN` is insufficient)
