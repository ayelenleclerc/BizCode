# Local dev and `npm run test:integration` (apply migrations: `npx prisma migrate deploy`)
#
# Prisma expects a full PostgreSQL URL. This line has no credentials (loopback URL only).
# If your Postgres requires a user/password, set the full URL in your real `.env` (gitignored) — never commit it.
DATABASE_URL=postgresql://127.0.0.1:5432/bizcode_dev?schema=public

# Staging seed / isolation guardrails (#152). Prefer STAGING_DATABASE_URL for remote staging;
# never set it equal to PROD_DATABASE_URL. Optional comma-separated production host denylist.
# STAGING_DATABASE_URL=
# PROD_DATABASE_URL=
# BIZCODE_PROD_DB_HOSTS=prod-db.example.com
# Local smoke: npm run seed:staging (uses DATABASE_URL → Docker Postgres :5432)

# Optional (#215): runtime app role without BYPASSRLS (migrate/seed keep superuser or BYPASSRLS).
# After migration `20260727210000_rls_tenant_isolation_215`, role `bizcode_app` exists for local checks.
# Example: postgresql://bizcode_app:PASSWORD@127.0.0.1:5432/bizcode_dev?schema=public
# Never set BIZCODE_RLS_BYPASS=true in production (seed/test helpers only).
# BIZCODE_RLS_BYPASS=false

# Required for `npm run server` (non-empty secret; local machine only).
# Production: inject via Doppler (or equivalent) — do not commit real values (#216).
JWT_SECRET=

# Optional previous HMAC secret during rolling rotation (#216). Minting always uses JWT_SECRET.
# JWT_SECRET_PREVIOUS=

# Redis for refresh-token blacklist (#212), MFA challenges (#213), and HTTP rate-limit store (#217).
# Required when NODE_ENV=production (#217). Local: docker compose -f docker-compose.redis.yml up -d
# REDIS_URL=redis://127.0.0.1:6379

# Express trust proxy hop count when behind Cloudflare/CDN (#217). Typical: 1. Leave unset locally.
# TRUST_PROXY=1

# Optional comma-separated source IPs allowed for provider webhooks (e.g. Mercado Pago). Empty = no IP filter (#217).
# WEBHOOK_IP_ALLOWLIST=

# MFA TOTP secret encryption (#213). Dedicated key — do NOT reuse BIZCODE_FISCAL_ENCRYPTION_KEY.
# Required in production (#216); local/dev falls back to a non-production default if unset.
# BIZCODE_MFA_ENCRYPTION_KEY=

# AFIP / Mercado Pago / Mercado Libre credential encryption at rest (AES-256-GCM).
# Required in production (#216); local/dev falls back to a non-production default if unset.
# BIZCODE_FISCAL_ENCRYPTION_KEY=

# Mercado Libre OAuth app (platform-level, #183). Register redirect URI = {API_PUBLIC_URL}/api/oauth/meli/callback
# MELI_CLIENT_ID=
# MELI_CLIENT_SECRET=
# MELI_REDIRECT_URI=http://localhost:3001/api/oauth/meli/callback
# Webhook secret for POST /api/webhooks/meli signature (#185) — from MeLi app notifications / Webhooks config
# MELI_WEBHOOK_SECRET=
# API_PUBLIC_URL=http://localhost:3001
# PORTAL_PUBLIC_URL=http://localhost:5173

# Platform SaaS billing Mercado Pago (#182). Unset token → mock subscribe. Live webhook needs secret.
# BIZCODE_SAAS_MP_ACCESS_TOKEN=
# BIZCODE_SAAS_MP_WEBHOOK_SECRET=
# BIZCODE_SAAS_MP_BACK_URL=http://localhost:5173/configuracion/billing

# OWASP ZAP (#194): optional GitHub Actions *repository variable* ZAP_TARGET_URL (staging/non-prod HTTPS only).
# Not an app runtime env. If unset, CI scans an ephemeral API on the runner. Never point at production with live secrets.

# Tiendanube / Nuvemshop OAuth app (platform-level, #187). Redirect = {API_PUBLIC_URL}/api/oauth/tiendanube/callback
# TIENDANUBE_CLIENT_ID=
# TIENDANUBE_CLIENT_SECRET=
# TIENDANUBE_REDIRECT_URI=http://localhost:3001/api/oauth/tiendanube/callback
# Optional override for webhook HMAC (defaults to TIENDANUBE_CLIENT_SECRET per TN docs)
# TIENDANUBE_WEBHOOK_SECRET=
# TIENDANUBE_USER_AGENT=BizCode (https://github.com/ayelenleclerc/BizCode)

# PostgreSQL automated backup (#150). Never commit real keys. Prefer Docker exec on Windows.
# BACKUP_ENCRYPTION_KEY=
# BIZCODE_BACKUP_DIR=.bizcode-backups
# BIZCODE_BACKUP_S3_URI=s3://bucket/prefix
# BIZCODE_POSTGRES_CONTAINER=bizcode_db
# BIZCODE_POSTGRES_USER=postgres
# BIZCODE_POSTGRES_DB=bizcode_dev
# BIZCODE_BACKUP_USE_DOCKER=true

# Required for API bootstrap (`development` | `test` | `production`).
NODE_ENV=development

# Required for `npx prisma db seed`: strong secret, local machine only (minimum 8 characters; see `prisma/seed.ts`).
BIZCODE_SEED_SUPERADMIN_PASSWORD=

# Optional: outbound email via SMTP_URL (smtp:/smtps:) or legacy SMTP_* variables (see server/channels.ts).
# SMTP_URL=smtp://user:pass@mail.example:587
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Optional security alert recipients for #221 (comma-separated). Soft-fail if unset.
# SECURITY_ALERT_EMAILS=ops@example.com
# SECURITY_ALERT_PHONES=+54911...
# SECURITY_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# BIZCODE_SECURITY_MONITOR=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# Optional OpenAI Whisper for App Seller speech-to-order (#266). Server only — never Expo public.
# If unset, POST /api/voice/transcribe returns 503 and the app falls back to on-device STT.
# OPENAI_API_KEY=
# LOG_LEVEL=info
# METRICS_ENABLED=true
# Optional POS hardware (default off; PDF/CAE always available):
# FISCAL_PRINTER_ENABLED=false
# THERMAL_PRINTER_ENABLED=false
# CORS_ORIGINS=https://app.example
# HTTP rate limits (#87 / #217). Authenticated general default 100/min per user; unauthenticated 20/min per IP.
# HTTP_RATE_LIMIT_PER_MINUTE=100
# HTTP_RATE_LIMIT_UNAUTH_PER_MINUTE=20
# HTTP_RATE_LIMIT_AUTH_PER_MINUTE=20
# HTTP_RATE_LIMIT_LOGIN_PER_15_MIN=5
# HTTP_RATE_LIMIT_LOGIN_USERNAME_PER_HOUR=10
# HTTP_RATE_LIMIT_REPORTS_PER_HOUR=10
# HTTP_RATE_LIMIT_IMPORT_PER_HOUR=5

# Optional: after SuperAdmin seed, upsert a minimal rubro (codigo=1) for local/demo parity (see docs/en/quality/test-environments-parity.md).
# BIZCODE_SEED_FIXTURE_CATALOG=true

# Optional: `npm run bootstrap:superadmin` — alternative to seed; does not update password if the user already exists (see README).
# BIZCODE_BOOTSTRAP_SUPERADMIN_PASSWORD=
# BIZCODE_BOOTSTRAP_SUPERADMIN_USERNAME=Ayelen

# Optional: legacy DBF tree for `npm run migrate:dbf` / `npx tsx scripts/inspect-dbf.ts` when Programa_Viejo is not under the repo root (absolute or relative to cwd).
# PROGRAMA_VIEJO_ROOT=D:/ruta/Programa_Viejo

# Optional: target Tenant.id for `npm run migrate:dbf` (defaults to the lowest Tenant.id when unset; requires at least one Tenant row, e.g. from `npx prisma db seed`).
# BIZCODE_MIGRATION_TENANT_ID=1

# ------------------------------------------------------------------------------
# Container deploy reference (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
# Prefer Doppler (or host secret injection) over a production `.env` with real values (#216).
# See docs/en/quality/secrets-management-and-doppler.md
# POSTGRES_DB=bizcode
# POSTGRES_USER=bizcode
# POSTGRES_PASSWORD=
# APP_ENV=production
# FRONTEND_PORT=8080
# VITE_API_URL=/api
# CORS_ORIGINS=https://app.example
# JWT_SECRET=
# JWT_SECRET_PREVIOUS=
# BIZCODE_FISCAL_ENCRYPTION_KEY=
# BIZCODE_MFA_ENCRYPTION_KEY=
# REDIS_URL=
# TRUST_PROXY=1
# WEBHOOK_IP_ALLOWLIST=
#
# Optional SSH deploy workflow (`.github/workflows/deploy.yml`) expects these
# repository secrets when auto-deploy is desired:
# - DEPLOY_HOST
# - DEPLOY_USER
# - DEPLOY_SSH_KEY
# - DEPLOY_PATH
# SSH port: workflow input `deploy_ssh_port` (default 22), not a repository secret
# - DATABASE_URL
# - POSTGRES_USER
# - POSTGRES_PASSWORD
# - POSTGRES_DB
# - APP_ENV
# - VITE_API_URL
# - CORS_ORIGINS
# - JWT_SECRET
# - BIZCODE_FISCAL_ENCRYPTION_KEY
# - BIZCODE_MFA_ENCRYPTION_KEY
# - GHCR_TOKEN (optional when `GITHUB_TOKEN` is insufficient)
#
# App Seller EAS (#173). GitHub Actions secrets only — never commit values.
# Operator: `eas init` in apps/seller, then set repository secrets:
# - EXPO_TOKEN
# - EAS_PROJECT_ID
# Optional baked-in API base for native builds (otherwise Expo public default is localhost):
# - EXPO_PUBLIC_API_BASE_URL
# Workflow: .github/workflows/seller-eas.yml on tags seller-v* (not Quality Gate).
#
# App Driver EAS (#166). Separate Expo project from Seller — never reuse EAS_PROJECT_ID.
# Operator: `eas init` in apps/driver, then set repository secrets:
# - EXPO_TOKEN (same token as Seller is fine)
# - EAS_DRIVER_PROJECT_ID (Driver Expo project UUID only)
# Optional (shared with Seller builds):
# - EXPO_PUBLIC_API_BASE_URL
# Workflow: .github/workflows/driver-eas.yml on tags driver-v* (not Quality Gate).
# Local: export EAS_DRIVER_PROJECT_ID before `pnpm --filter @bizcode/driver eas:build:internal`.
#
# Mobile TLS certificate pinning (#220). Empty = no pinning (dev / Expo Go / localhost Docker :5432).
# Required for EAS production/internal Android builds in CI (fail-closed). SPKI SHA-256 base64, comma-separated.
# EXPO_PUBLIC_API_TLS_PINS=
# EXPO_PUBLIC_API_TLS_PIN_HOST=api.example.com
# Optional pin-set expiration (YYYY-MM-DD), default 2028-12-31:
# EXPO_PUBLIC_API_TLS_PIN_EXPIRATION=2028-12-31
# GitHub Actions secrets (same names) for seller-eas.yml / driver-eas.yml tag builds.
# Pinning applies on EAS / dev client native builds only — not Expo Go.
