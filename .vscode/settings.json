{
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "files.associations": {
    "**/prisma/migrations/**/*.sql": "postgres"
  },
  "[postgres]": {
    "editor.formatOnSave": false
  },
  "prisma.pinToPrisma6": true,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/dist": true,
    "**/coverage": true
  }
}
